@model Connect4m_Web.Models.Attendenceproperites.UserScreen.CoolLinks
@{
    ViewData["Title"] = "Manage Cool Links";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-1 text-center text-header">MANAGE COOL LINKS </h4>
        <div class="row mb-2">
            <span id="Validationmessage" class="text-danger text-header"></span>
            <div class="text-end" id="Manageholidays_Heaingmaindiv0">
                <button type="button" class="btn btn-label-linkedin waves-effect btn-sm" id="Addnewcoolinkbtn"> Create Cool Link </button>
            </div>

            <div id="Searchcontainerdiv">
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white text-header">SEARCH COOL LINKS</div>
                    <div class="card-body">
                        <form id="Searchform">
                            <div class="row mb-1">
                                <label class="control-label col-sm-4 col-form-label text-end space">Cool Link Name</label>
                                <div class="col-sm-4">
                                    <input type="text" asp-for="Name" id="Linknametxt" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-1">
                                <label class="control-label col-sm-4 col-form-label text-end space">Cool Link URL</label>
                                <div class="col-sm-4">
                                    <input type="text" asp-for="Url" id="Linkurltxt" class="form-control" />
                                </div>
                            </div>
                            <div class="row mb-1">
                                <label class="control-label col-sm-4 col-form-label text-end space">Description</label>
                                <div class="col-sm-4">
                                    <textarea class="form-control" asp-for="Description" id="Descriptiontxt"></textarea>
                                </div>
                            </div>
                            <div class="col-sm-12 text-center">
                                <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Clearfun('Searchform', 'Validationmessage')" id="Clearcoollink_Btn">Clear</button>
                                <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="Searchbtn">Search</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white text-header">
                        YOUR SEARCH RESULTED <span id="Recordscount" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span> RECORDS.
                    </div>
                    <div class="table-responsive text-nowrap">
                        <table id="Coollinkstbl_id" class="table table-hover table-bordered no-footer">
                            <thead class="table-dark">
                                <tr>
                                    <th>SNO</th>
                                    <th>Cool Link Name</th>
                                    <th>Cool Link URL</th>
                                    <th>Description</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div id="Addnewlinkscontainerdiv"></div>
        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery/dist/jquery.min.js"></script> <!-- jQuery -->
<script src="~/lib/jquery-validation/jquery.validate.min.js"></script> <!-- jQuery Validation -->
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script> <!-- jQuery Unobtrusive Validation -->
<script src="~/js/Coollinks.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
