@model Connect4m_Web.Models.LMSproperties.ManageCategory
@{
    ViewData["Title"] = "CreateManageCategory";
    Layout = null;
}
@*<link href="~/css/CommonStyle.css" rel="stylesheet" />*@

<div class="card">
    <div class="card-header bg-danger text-white">
        <span id="updatesalaryattribute">CREATE</span> CATEGORY DETAILS
    </div>

    @*<h5 class="mb-3">
            <span id="updatesalaryattribute">CREATE</span>  Category Details
        </h5>*@
    <div class="card-body">
        <form id="Insert_MC" class="needs-validation was-validated" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="text" asp-for="PayrollCategoryId" name="PayrollCategoryId" hidden style="display:none" readonly />
            <div class="row mb-3">
                <label class="control-label col-sm-4 col-form-label text-end space" for="basic-default-name" asp-for="PayrollCategoryName"></label>
                <div class="col-sm-4">
                    <input class="form-control" asp-for="PayrollCategoryName" required>
                    <span asp-validation-for="PayrollCategoryName" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="control-label col-sm-4 col-form-label text-end space" for="basic-default-name" asp-for="PayrollCategoryDescription"></label>
                <div class="col-sm-4">
                    <input class="form-control" asp-for="PayrollCategoryDescription">
                    <span asp-validation-for="PayrollCategoryDescription" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label class="control-label col-sm-4 col-form-label text-end space" for="basic-default-name" asp-for="isLeaveApplicable"></label>
                <div class="col-sm-4" style="display:flex">
                    <div class="form-check form-check-primary col-4">
                        <input asp-for="isLeaveApplicable" class="form-check-input" name="isLeaveApplicable" type="radio" value="0" checked required>
                        <label class="form-check-label">
                            PayRoll
                        </label>
                    </div>
                    <div class="form-check form-check-primary col-3">
                        <input asp-for="isLeaveApplicable" class="form-check-input" name="isLeaveApplicable" type="radio" value="1" required>
                        <label class="form-check-label">
                            Leave
                        </label>
                    </div>
                    <div class="form-check form-check-primary col-3">
                        <input asp-for="isLeaveApplicable" class="form-check-input" name="isLeaveApplicable" type="radio" value="2" required>
                        <label class="form-check-label">
                            Both
                        </label>
                    </div>
                    <span asp-validation-for="isLeaveApplicable" class="text-danger"></span>
                </div>
            </div>
            <div class="col-sm-12 text-center">
                <button type="button" class="btn btn-info waves-effect waves-light btn-sm" id="backtopage_MC" onclick="nextpage('SearchSalaryAttributesForRoles',null)">Previous Page</button>
                <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="backtosearch_MC">Back To Search</button>
                <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="clearform" onclick="SaveClearform('Insert_MC')">Clear</button>
                <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Save_MC">Save</button>
                <button type="button" class="btn btn-primary waves-effect waves-light btn-sm" id="Nextpage_MC" onclick="nextpage('SearchManageSubCatogory',null)">Next Page</button>
            </div>
        </form>
    </div>
</div>
@*<script src="~/Datatable/jquery.dataTables.js"></script>
    <script src="~/Datatable/jquery.dataTables.min.js"></script>*@
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script src="~/js/PayRoll_3.js"></script>
