                    //url: '/FeeSection/Feereceipt_Users_Challan_Result_Tbl?FeeTypeIds=' + FeeTypeIds + '&FeeTermId=' + FeeTermId + '&UserIds=' + selectedUserIds + '&InstanceId=' + InstanceId,
                    type: 'POST',
                    processData: false, // Prevent jQuery from processing the data
                    contentType: false, // Let the server handle the content type
                    success: function (response) {

                        debugger;
                        if (response.statusCode === -200) {
                            // Redirect to an error page if the response indicates an error
                            window.location.href = '/Attendance/ErrorPage';
                        }

                        if (response && response.data) {
