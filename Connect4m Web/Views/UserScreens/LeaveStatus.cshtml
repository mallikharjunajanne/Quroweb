
@{
    Layout = null;
}

<style>
    .Waitingtbl {
        width: 100%;
        border-collapse: separate;
        border: 1px solid #afd4f7;
    }
        .Waitingtbltr {
            background-color: #E8E8E8;
            font-size: 14px;
            font-weight: 700;
            height: 26px;
            text-align: center;
            color: black;
        }
    .Waitingtbltrtd {
        border: 1px solid #dbdbdb;
        height: 24px;
        color:black
    }
</style>

<div>
    <span class="text-dark" style="font-weight: 900; border-bottom: 1px solid black;"> WAITING FOR APPROVAL</span><br />
    <table class="Waitingtbl">
        <tbody>
            <tr class="Waitingtbltr">
                <th>Staff Leave(s)</th>
                <th>Student Leave(s)</th>
            </tr>
            @{
                var Countone = ViewBag.studentstaffleavescount.Count;
            }
            @if (Countone != 0)
            {
                @foreach (var items_1 in ViewBag.studentstaffleavescount)
                {
                    <tr style="text-align: center;">
                        <td class="Waitingtbltrtd">@items_1.Staffleaves</td>
                        <td class="Waitingtbltrtd">
                            @if (string.IsNullOrWhiteSpace(items_1.Studentleaves))
                            {
                                @:0
                            }
                            else
                            {
                                @items_1.Studentleaves
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr style="text-align: center;">
                    <td colspan="2" class="Waitingtbltrtd">No Records</td>
                </tr>
            }
        </tbody>
    </table>

    <span class="text-dark" style="font-weight: 900; border-bottom: 1px solid black;">MY LEAVE(S) STATUS</span><br />
    <table class="Waitingtbl">
        <tbody>
            <tr class="Waitingtbltr">
                <th align="center">Leave Type</th>
                <th align="center">From Date</th>
                <th align="center">To date</th>
                <th align="center">No. of Days</th>
                <th align="center">Status</th>
            </tr>
            @{
                var Counttwo = ViewBag.leavestatus.Count;
            }
            @if (Counttwo != 0)
            {
                @foreach (var item_4 in ViewBag.leavestatus)
                {
                    <tr>
                        <td class="Waitingtbltrtd">@item_4.LeaveType</td>
                       
                        <td class="Waitingtbltrtd">@item_4.FromDate</td>
                        <td class="Waitingtbltrtd">@item_4.ToDate</td>
                        <td class="Waitingtbltrtd">@item_4.LeaveDays</td>
                        <td class="Waitingtbltrtd">@item_4.Status</td>
                    </tr>
                }
            }
            else
            {
                <tr style="text-align: center;">
                    <td colspan="5" class="Waitingtbltrtd">No Records</td>
                </tr>
            }
        </tbody>
    </table>
    <div>
        <br />
    </div>
    <table class="Waitingtbl">
        <tbody>
            <tr class="Waitingtbltr">
                <th>Leave Type</th>
                <th>Total</th>
                <th>Used</th>
                <th>Approved Not Used</th>
                <th>Leaves Awaiting Approval</th>
                <th>Available</th>
            </tr>

            @{
                var Countthree = ViewBag.leavetypes.Count;
                // Define the function to remove HTML tags from a string
                //string RemoveHtmlTags(string input)
                //{
                //    var output = System.Text.RegularExpressions.Regex.Replace(input, "<[^>]*?>", String.Empty);
                //    return output;
                //}
            }
            @if (Countthree != 0)
            {
                @foreach (var item_2 in ViewBag.leavetypes)
                {
        <tr>
            <td class="Waitingtbltrtd">@item_2.LeaveType</td>
            @*<td class="Waitingtbltrtd">@RemoveHtmlTags(item_2.LeaveType)</td>*@
            <td class="Waitingtbltrtd">@item_2.Total</td>
            <td class="Waitingtbltrtd">@item_2.DaysUsed</td>
            <td class="Waitingtbltrtd">@item_2.Approved</td>
            <td class="Waitingtbltrtd">@item_2.InProcess</td>
            <td class="Waitingtbltrtd">@item_2.Available</td>
        </tr>
                }
            }
            else
            {
                <tr style="text-align: center;">
                    <td colspan="5" class="Waitingtbltrtd">No Records</td>
                </tr>
            }
        </tbody>
    </table>
</div>
