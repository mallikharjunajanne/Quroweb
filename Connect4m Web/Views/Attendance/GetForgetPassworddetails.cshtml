@model Connect4m_Web.Models.Forgotdetails
@{
    Layout = null;
}

<div class="authentication-wrapper authentication-cover authentication-bg">
    <div class="authentication-inner row">
        <div class="col-sm-12 row">
            <div class="col-sm-1">
                <div class="row-2">
                    <label></label>
                </div>
            </div>
            <div class="col-sm-10">
                <div class="header">
                    <img src="/assets/img/QuroSchool_Logo.png" alt="Quro Logo" width="70" height="70">
                    <div class="school-infos">
                        <span class="school-name"><b>QURO SCHOOLS</b></span><br>
                        <span class="school-address">Welcome to Endless Possibilites</span>
                    </div>
                </div>
            </div>
            <div class="col-sm-1"></div>
        </div>
        <div class="col-sm-12 row">
            <div class="col-sm-1">
                <div class="row-2">
                    
                </div>
            </div>
            <div class="col-sm-10">
                <span class="text-validation" id="fperrormessage"></span>
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <span class="text-header">  Forgot Password Details </span>
                    </div>
                    <div class="card-body">
                        <form id="Formforgetpassword">
                            <div class="">
                                <input type="hidden" id="StudentUsertxtid" asp-for="StudentUserid" value="@ViewBag.Userlogindetails[0].StudentUserid" />
                                <input type="hidden" id="Mobilenumbertxtid" asp-for="Mobilenumber" value="@ViewBag.Userlogindetails[0].Mobilenumber" />
                                <input type="hidden" id="Portalemailtxtid" asp-for="Portalemail" value="@ViewBag.Userlogindetails[0].Portalemail" />
                                <input type="hidden" id="Usernametxtid" asp-for="Username" value="@ViewBag.Userlogindetails[0].Username" />
                                <input type="hidden" id="FirstNametxtid" asp-for="FirstName" value="@ViewBag.Userlogindetails[0].FirstName" />
                                <input type="hidden" id="SendSMStxtid" asp-for="SendSMS" value="@ViewBag.Userlogindetails[0].SendSMS" />
                                <input type="hidden" id="RoleNametxtid" asp-for="RoleName" value="@ViewBag.Userlogindetails[0].RoleName" />
                                <input type="hidden" id="SubDomineNametxtid" asp-for="SubDomineName" value="@ViewBag.Userlogindetails[0].SubDomineName" />
                                <input type="hidden" id="InstanceIDtxtid" asp-for="InstanceID" value="@ViewBag.Userlogindetails[0].InstanceID" />
                            </div>

                            <div class="row mb-2">
                                <label class="control-label col-sm-4 col-form-label text-end required space">Password  </label>
                                <div class="col-sm-4">
                                    <input type="password" asp-for="Password" class="form-control" id="Passwordtxt" placeholder="Password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label class="control-label col-sm-4 col-form-label text-end required space">ConfirmPassword </label>
                                <div class="col-sm-4">
                                    <input type="password" asp-for="ConfirmPassword" class="form-control" id="ConfirmPasswordtxt" placeholder="Confirm Password" maxlength="10">
                                    <span asp-validation-for="ConfirmPassword" class="text-danger" id="ConfirmPasswordvalidationspid"></span>
                                </div>
                            </div>
                            <div class="col-sm-12 text-center">
                                <button type="button" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Fgclearfun('Formforgetpassword')" id="btnClearChangePassword">Clear</button>
                                <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="btnSubmitChangePassword">Submit</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-sm-1"></div>
        </div>

        <footer class="text-center">
            <span>Copyright © 2024 Quroschools.com</span>
        </footer>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
<script src="~/js/Forgetpassword.js"></script>
