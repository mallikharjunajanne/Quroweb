@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<ChallanaDetails>
<style>
    .card-body {
        padding: 5px;
    }

    .challan {
        border: 1px solid #000;
        padding: 10px;
        border-radius: 10px;
        font-family: Arial, sans-serif;
        margin-bottom: 1px;
    }

    .header {
        display: flex;
        align-items: center;
    }

    .school-infos {
        margin-left: 20px;
    }

    .school-name {
        font-size: 16px;
        font-weight: bold;
    }

    .school-address {
        font-size: 12px;
        color: #333333;
    }

    .content {
        margin-top: 20px;
    }

    .row {
        display: flex;
        margin-bottom: 10px;
    }

    .value {
        flex: 1;
    }

    .footer {
        margin-top: 20px;
    }

        .footer .row {
            display: flex;
        }

        .footer .label {
            flex: 1;
            text-align: center;
        }

    .matric-challana {
        border: 2px solid #333; /* Border color */
        border-radius: 10px; /* Rounded corners */
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .school-info {
        text-align: center;
        margin-bottom: 20px;
    }

        .school-info p {
            font-size: 18px;
            margin: 5px 0;
        }

        .school-info h2 {
            font-size: 24px;
            margin: 5px 0;
        }

    .receipt-details {
        margin-top: 20px;
    }

    .row {
        display: flex;
        margin-bottom: 10px;
    }

    .label {
        flex: 1;
        text-align: right;
        margin-right: 10px;
        font-weight: bold;
    }

    .total-fee {
        text-align: center;
        margin-top: 20px;
        font-weight: bold;
    }

    .signature {
        text-align: center;
        margin-top: 20px;
    }

    hr {
        border: none;
        border-top: 1px solid #333; /* Divider color */
        margin: 10px 0;
    }

    #dateSpan {
        margin-left: 85%;
    }
</style>

<div class="card-body">
    <div class="justify-content text-end">
        <button id="Print_Matrix_Button" class="btn btn-label-linkedin waves-effect btn-sm">PRINT On Dot-Matrix</button>
        <button id="Print_Button" class="btn btn-label-linkedin waves-effect btn-sm">Print</button>
    </div>
    @foreach (var item in Model)
    {
        <div id="Fee_DetailsPrint" class="challan">
            <span id="dateSpan"></span>
            <span id="timeSpan"></span>
            <div class="header">
                <img src="~/assets/img/QuroSchool_Logo.png" alt="Quro Logo" width="100px" height="100px"/>
                <div class="school-infos">
                    <span class="school-name"><b>QURO SCHOOLS</b></span><br>
                    <span class="school-address">2A, Siva Sadan, SRK Colony, Opp HDFC Bank, West Marredpally (Secunderabad), Hyderabad, 500026</span>
                </div>
            </div>
            <div class="content">
                <div class="row">
                    <div class="label">Name :</div>
                    <div class="value">@item.Challana_UserName</div>
                    <div class="label">Fee Amount :</div>
                    <div class="value">@item.Challana_FeeAmount</div>
                </div>
                <div class="row">
                    <div class="label">Registration Number:</div>
                    <div class="value">@item.Challana_UserRegId</div>
                    <div class="label">Discount Type :</div>
                    @if (String.IsNullOrEmpty(item.Challana_DiscountType))
                    {
                        <div class="value">NA</div>
                    }
                    else
                    {
                        <div class="value">@item.Challana_DiscountType</div>
                    }
                    @*<div class="value">@String.IsNullOrEmpty(item.Challana_DiscountType) ? NA : item.Challana_DiscountType</div>*@
                </div>
                <div class="row">
                    <div class="label">Department:</div>
                    <div class="value">@item.Challana_ClassificationName</div>
                    <div class="label">Discount Amount :</div>
                    @if (item.Challana_DiscountAmount == "NaN")
                    {
                        <div class="value">0.00</div>
                    }
                    else
                    {
                        <div class="value">@item.Challana_DiscountAmount</div>
                    }

                    @*<div class="value">@String.IsNullOrEmpty(item.Challana_DiscountAmount) || item.Challana_DiscountAmount == "NaN" ? "0.00" : item.Challana_DiscountAmount</div>*@
                </div>
                <div class="row">
                    <div class="label">Semester:</div>
                    <div class="value">@item.Challana_subclassificationName</div>
                    <div class="label">Paid Amount :</div>
                    @if (item.Challana_PaidAmount == "NaN")
                    {
                        <div class="value">0.00</div>
                    }
                    else
                    {
                        <div class="value">@item.Challana_PaidAmount</div>
                    }

                    @*<div class="value">@String.IsNullOrEmpty(item.Challana_PaidAmount) || item.Challana_PaidAmount == "NaN" ? "0.00" : item.Challana_PaidAmount</div>*@
                </div>
                <div class="row">
                    <div class="label">Term:</div>
                    <div class="value">@item.Challana_TermName</div>
                    <div class="label">Due Amount :</div>
                    <div class="value">@item.Challana_DueAmount</div>
                </div>
                <div class="row">
                    <div class="label">Due Date:</div>
                    <div class="value">@item.Challana_DueDate</div>
                    <div class="label">Paying Amount :</div>
                    <div class="value">@item.Challana_PayingAmount</div>
                </div>
                <div class="row">
                    <div class="label">Fee type:</div>
                    <div class="value">@item.Challana_FeeType</div>
                    <div class="label">Balance Due :</div>
                    <div class="value">@item.Challana_BalanceDue</div>
                </div>
            </div>
            <div class="footer">
                <div class="row">
                    <div class="label">Stamp</div>
                    <div class="label">Signature Of Accountant</div>
                    <div class="label">Signature Of Payee</div>
                </div>
            </div>
        </div>
        <div id="MatricChallanaPrint" class="matric-challana">
            <div class="school-info">
                <p>QURO SCHOOLS - HYDERABAD, H.S - 2, Sector - 23, Opposite Pkt. - 3</p>
                <h2>***** FEE RECEIPT *****</h2>
            </div>
            <div class="receipt-details">
                <div class="row">
                    <div class="label">RECEIPT NO :</div>
                    <div class="value">@item.ReturnStringValue</div>
                    <div class="label">RECEIPT DATE :</div>
                    <div class="value">@item.Challana_UserName</div>
                </div>
                <div class="row">
                    <div class="label">Name :</div>
                    <div class="value">@item.Challana_UserName</div>
                    <div class="label">CLASS :</div>
                    <div class="value">@item.Challana_subclassificationName</div>
                    <div class="label">ADM.NO :</div>
                    <div class="value">@item.Challana_UserRegId</div>
                </div>
                <div class="row">
                    <div class="label">Instalment Number :</div>
                    <div class="value">@item.Challana_TermName</div>
                </div>
                <div class="row">
                    <div class="label">Amount :</div>
                    <div class="value">@item.Challana_PayingAmount</div>
                </div>
                <hr>
                <div class="total-fee">
                    TOTAL FEE: @item.Challana_PayingAmount
                </div>
                <hr>
                <div class="signature">
                    <label>SIGNATURE</label>
                </div>
            </div>
        </div>
    }
    <div class="justify-content text-center">
        <button type="button" id="Pfuchallanbacktosearchbtn" class="btn btn-dark waves-effect waves-light">Back To Search</button>
        <button type="button" id="Pfuchallanbacktopayfeebtn" class="btn btn-dark waves-effect waves-light">Back To Pay Fee</button>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/Payfeeforuserpartialview.js"></script>