@model Connect4m_Web.Models.Attendenceproperites.UserScreen.Bankdeposit
@{
    ViewData["Title"] = "FeeStatus";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = null;
}

<style>
    .popup {
       display: none;
        position: fixed;
        z-index: 1;
        left: 0%;
        /*left: 10%;*/
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        justify-content: center;
        align-items: center;
    }

    /* Style for the image container inside the modal */
    .popup-content {
        max-width: 100%;
        max-height: 81%;
        background-color: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
        overflow: auto;
        width: 61%;
        margin-left: 20%;
    }


    /* Close button for the popup */
    .close-btn {
       /* position: absolute;*/
        top: 10px;
        right: 10px;
        font-size: 30px;
        color: black;
        background-color: transparent;
        border: none;
        cursor: pointer;
    }

    /* Style for the image */
    .popup-content img {
        width: 100%;
        height: auto;
    }

    /* Style for the PDF iframe */
    .popup-content iframe {
        width: 100%;
        height: 500px;
    }
</style>


<div class="col-md-12 col-lg-12 mb-3">
    <div class="text-right">
        <a href="" id="Backtosearchlnk" class="btn btn-label-linkedin waves-effect btn-sm">Back to Search</a>
    </div>
    <div class="card mb-4">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
            UPDATE DEPOSIT DETAILS
            <small class="text-header-small">* INDICATES REQUIRED FIELDS</small>
        </div>
        <div class="card-body">
            <form id="Updatebankdepositform" enctype="multipart/form-data">
                <div class="mb-2 row">
                    <label class="col-sm-2 col-form-label space required text-end" for="basic-default-name">Payment Mode</label>
                    <div class="col-sm-4">
                        @*@Html.DropDownListFor(x => x.Paymentmodeid, new SelectList(ViewBag.PaymentModeddl, "Value", "Text"),
                        "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "Paymentmodeidddl", @style = "color:black;", @required = "required" })*@
                        <select id="Paymentmodeidddl" asp-for="Paymentmodeid" class="form-select">
                            @foreach (var item in ViewBag.PaymentModeddl)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Paymentmodeid" class="text-danger"></span>
                        <input type="hidden" asp-for="FeeDepositId" id="Feedeposittxtid" />
                    </div>

                </div>
                <div class="mb-2 row">
                    <label class="col-sm-2 col-form-label space required text-end" for="basic-default-name">Deposit Amount</label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="Depositamount" class="form-control" id="Depositamounttxt" name="Depositamount" autocomplete="off" />
                        <span asp-validation-for="Depositamount" class="text-danger"></span>
                    </div>
                    <label class="col-sm-2 col-form-label space required text-end" for="basic-default-name">Date of Deposit</label>
                    <div class="col-sm-4">
                        @*<input type="date" asp-for="Depositdate" class="form-control" id="Depositdatetxt" name="Depositdatetxt" autocomplete="off" />*@
                        <input type="date" asp-for="Datedeposit" class="form-control" id="Depositdatetxtid" name="Datedeposit" autocomplete="off" />
                        <span asp-validation-for="Datedeposit" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-2 row">
                    <label class="col-sm-2 col-form-label space required text-end" for="basic-default-name">Bank Name </label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="BankName" class="form-control" id="BankNametxt" name="BankName" autocomplete="off" value="HDFC Bank" readonly />
                        <span asp-validation-for="BankName" class="text-danger"></span>
                    </div>
                    <label class="col-sm-2 col-form-label space required text-end">Branch Name </label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="Branchname" class="form-control" id="Branchnametxt" name="Branchname" autocomplete="off" value="Marredpally" readonly />
                        <span asp-validation-for="Branchname" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-2 row">
                    <label for="FirstName" class="col-sm-2 col-form-label space required text-end">Account Number</label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="Accountnumber" class="form-control" id="Accountnumbertxt" name="Accountnumber" autocomplete="off" value="99998367009696" readonly />
                        <span asp-validation-for="Accountnumber" class="text-danger"></span>
                    </div>
                    <label class="col-sm-2 col-form-label space text-end">Document </label>
                    <div class="col-sm-4">
                        @if (ViewBag.Documentname != null && ViewBag.Documentname != "")
                        {
                            <div id="Documentiddiv">
                                <span style=" text-decoration: underline; color: blue; cursor: pointer;" onclick="Showimage('@ViewBag.Documentname','@ViewBag.instanceid')">
                                    @ViewBag.Documentname
                                </span>
                                <button type="button" class="btn btn-sm btn-danger" onclick="Imagedlt()">Delete</button>
                            </div>
                            <input type="file"  asp-for="DocumentName" class="form-control" id="AttachedDocument" name="AttachedDocumenttxt" style="display:none;"/>
                        }
                        else
                        {
                            <input type="file" asp-for="DocumentName" class="form-control" id="AttachedDocument" name="AttachedDocumenttxt" />
                        }
                        <div id="imagePreviewContainer"></div>
                    </div>
                </div>
                <div class="mb-1 row">
                    <label class="col-sm-1"></label>
                    <label class="col-sm-12 text-center text-grey"> <b>Note:</b> You cannot upload more than 1Mb document. The document formats should be .doc or .docx or .pdf or .jpeg or .jpg or .png or .gif</label>
                </div>
                <div class="mb-2 row">
                    <label for="FirstName" class="col-sm-2 col-form-label space text-end">Comments </label>
                    <div class="col-sm-4">
                        <textarea asp-for="Comments" class="form-control" id="Commentstxta" name="Comments" autocomplete="off"></textarea>
                    </div>
                </div>
                <div class="justify-content-center text-center">
                    <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="InsertClearform('Bankdepositform')" id="Clearbtn">Clear</button>
                    <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="submitbtn">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="popup" id="popup">
    <div class="popup-content">
        <button class="close-btn" onclick="closePopup()">×</button>
        <div id="popup-file-container"></div>
    </div>
</div>




<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/Updatebankdeposite.js"></script>
<script src="~/js/CommonScripts.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
