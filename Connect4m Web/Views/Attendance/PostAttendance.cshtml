@model Connect4m_Web.Models.Attendenceproperites.Attendancepost
@{
    ViewData["Title"] = "POST ATTENDANCE";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>  
    <link href="~/css/PostAttendance.css" rel="stylesheet" />
</head>
<body>
  <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-3 text-center text-header">POST ATTENDANCE </h4>
        <div class="row mb-2">
            <div class="col-md-12 col-lg-12 mb-3">
                <span id="Errormessage" class="text-validation"></span>
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
                        <span class="text-header">SEARCH FOR STUDENTS</span>
                            <small class="text-header-small">* INDICATES MANDATORY FIELD</small>
                    </div>
                    <div class="card-body">
                        <form class="form" id="Postattendaceformid">
                            <input type="hidden" id="ROLENAMESPANID" value="@ViewBag.rolename" />
                            <div id="Admin_Lg_Div_id">
                                <div class="row mb-3">
                                    <label asp-for="StartDate" id="RlStartdate" class="control-label col-sm-3 col-form-label text-end required space">
                                        StartDate
                                    </label>
                                    <div class="col-sm-4">
                                        <input type="date" id="StartDateid" asp-for="StartDate" class="form-control">
                                        <span id="Roldisplaydate" class="form-control" style="display:none;"></span>
                                        <span asp-validation-for="StartDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="row mb-3" id="Rlenddate">
                                    <label asp-for="EndDate" class="control-label col-sm-3 col-form-label text-end required space">
                                        EndDate
                                    </label>
                                    <div class="col-sm-4">
                                        <input type="date" id="EndDateid" asp-for="EndDate" class="form-control">
                                        <span asp-validation-for="EndDate" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mb-3" id="Rldepartment">
                                    <label asp-for="InstanceClassificationId" class="control-label col-sm-3 col-form-label text-end required space">
                                        Department
                                    </label>
                                    <div class="col-sm-4">
                                        <div class="position-relative">
                                            <select class="select2 form-select select2-hidden-accessible" id="Ddldepartment" asp-for="InstanceClassificationId">
                                            </select>
                                            <span asp-validation-for="InstanceClassificationId" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <label class="control-label col-sm-3 col-form-label text-end space">
                                        Total Credits
                                    </label>
                                    <label class="control-label col-sm-2 col-form-label text-danger">
                                        @ViewBag.TotalCredits
                                    </label>

                                </div>
                                <div class="row mb-3" id="Rlclass">
                                    <label asp-for="InstanceSubclassificaitionId" class="control-label col-sm-3 col-form-label text-end required space">
                                        Class
                                    </label>
                                    <div class="col-sm-4">
                                        <div class="position-relative">
                                            <select class="select2 form-select select2-hidden-accessible" id="DdlSubClass" asp-for="InstanceSubclassificaitionId">
                                            </select>
                                            <span asp-validation-for="InstanceSubclassificaitionId" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <label class="control-label col-sm-3 col-form-label text-end space">
                                        Used Credits
                                    </label>
                                    <label class="control-label col-sm-2 col-form-label text-danger">
                                        @ViewBag.UsedCredits
                                    </label>
                                </div>

                                <div class="row mb-3">
                                    <label asp-for="InstancesubjectId" class="control-label col-sm-3 col-form-label text-end required space">Slot</label>
                                    <div class="col-sm-4">
                                        <div class="position-relative">
                                            <select class="select2 form-select select2-hidden-accessible" id="Ddslotsid" asp-for="InstancesubjectId">
                                            </select>
                                            <span asp-validation-for="InstancesubjectId" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <label class="control-label col-sm-3 col-form-label text-end space">
                                        Remaining Credits
                                    </label>
                                    <label class="control-label col-sm-2 col-form-label text-danger">
                                        @ViewBag.RemCredits
                                    </label>
                                </div>
                                <div class="row mb-3">
                                    <label class="control-label col-sm-3 col-form-label text-end"></label>
                                    <div class="col-sm-4">
                                        <input type="checkbox" class="form-check-input checkbox_animated" asp-for="ShowChangeActivity" id="Changactivitychk">
                                        <label class="form-check-label" id="Changactivitychk" asp-for="ShowChangeActivity">Show Change Activity</label>
                                    </div>
                                </div>
                                <div class="col-sm-10 text-center">
                                    <button type="button" class="btn btn-danger waves-effect waves-light btn-sm" id="btndelete" onclick="AttendancedeleteAll();" style="display:none;">Delete</button>
                                    <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Get_atd_btn">Get Attendance Form</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div id="GetAttendance_Table">

                </div>
            </div>
        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.0/jquery-ui.min.js"></script>



<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery/dist/jquery.js" type="text/javascript"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script src="~/Datatable/jquery.dataTables.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>

<script src="~/js/Get_ClassificationNames.js"></script>
<script src="~/js/Getclassification1.js"></script>


<script>
    //Date Function Javascript Code start
    var date = new Date();
    var day = date.getDate();
    var month = date.getMonth() + 1;
    var year = date.getFullYear();

    if (month < 10) month = "0" + month;
    if (day < 10) day = "0" + day;

    var today = year + "-" + month + "-" + day;

    document.getElementById("StartDateid").value = today;
    document.getElementById("EndDateid").value = today;


</script>


