@model Connect4m_Web.Models.LMSproperties.Managesubjecttools

@{
    ViewData["Title"] = "Insertsubjecttool";
    Layout = null;
}
<link href="~/css/Managesubjecttools.css" rel="stylesheet" />
<input type="text" value="@ViewBag.decidemst" id="Decide_Up_Save" hidden />

<div class="card mb-3">
    <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
        <span id="InsertUpdate_Spantxt"> SAVE SUBJECT TOOL DETAILS</span>
    </div>
    <div class="card-body">
        <form id="Insertsubjecttool">

            <div class="row mb-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-sm-4">
                    <input asp-for="InstanceSubjectToolId" class="form-control" id="formInstanceSubjectToolId" hidden />
                </div>
            </div>

            <div class="form-group row mb-3">
                <label asp-for="SubjectToolName" class="control-label col-sm-4 col-form-label text-end required space"></label>
                <div class="col-sm-4">
                    <input asp-for="SubjectToolName" class="form-control" />
                    <span asp-validation-for="SubjectToolName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label asp-for="SubjectsDisplayOrder" class="control-label col-sm-4 col-form-label text-end space"></label>
                <div class="form-group col-sm-4">
                    <input asp-for="SubjectsDisplayOrder" class="form-control" />
                    <span asp-validation-for="SubjectsDisplayOrder" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row mb-3">
                <label asp-for="Comments" class="control-label col-sm-4 col-form-label text-end space"></label>
                <div class="form-group col-sm-4">
                    <textarea asp-for="Comments" class="form-control"></textarea>
                    @*<span style="font-weight:300">(Max of 250 Characters)</span>*@
                    <span id="subtools_remaining_char"> 250 Character(s) remaining.  </span>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>
            </div>
            <div class="col-sm-12 text-center">
                <button type="reset" class="btn btn-danger waves-effect waves-light" id="clearform">Clear</button>
                <a class="btn btn-primary" href="/Videos/Managesubjecttools">Back To Search</a>
                <button class="btn btn-success waves-effect waves-light" id="sub_tblsubjecttools"></button>
            </div>

            @*<div class="form-group col-8"><input asp-for="SubjectToolName" class="form-control" />
                <span asp-validation-for="SubjectToolName" class="text-danger"></span></div>*@
            @*<div class="form-group col-2"><input type="reset" value="Clear" class="btn btn-danger" id="clearform" /></div>
                <div class="form-group col-4">
                <a class="btn btn-primary" href="/Videos/Managesubjecttools">Back To Search</a>
                </div>
                <div class="form-group col-2">
                <input type="submit" value="Create" id="sub_tblsubjecttools" class="btn btn-success" />
                </div>*@

        </form>
    </div>
</div>



<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="~/js/insertingsubjecttools.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
