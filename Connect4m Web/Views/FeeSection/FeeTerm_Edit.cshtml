@model Connect4m_Web.Models.Attendenceproperites.Feeterms
@{
    ViewData["Title"] = "Update FeeTerm";
    Layout = null;
    //Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="col-md-12 col-lg-12 mb-3">
    <div class="card mb-4">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
            UPDATE FEE TERM
            <small class="text-header-small">* INDICATES REQUIRED FIELDS</small>
        </div>
        <div class="card-body">
            <form id="UpdateFeetermform" enctype="multipart/form-data">
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label space text-end required" for="basic-default-name">Academic Year</label>
                    <div class="col-sm-4">
                        <select asp-for="AcademicYearId" class="form-select" id="ddlAcademicYear">
                            @foreach (var item in ViewBag.AcademicyearItems)
                            {
                                bool isSelect = false;
                                @foreach (var Academicyear in ViewBag.modellist)
                                {
                                    @if (item.Value == Academicyear.AcademicYearId.ToString())
                                    {
                                        isSelect = true;
                                        break;
                                    }
                                }
                                @if (isSelect == true)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>

                        <span asp-validation-for="AcademicYearId" class="text-danger"></span>
                        <input type="hidden" asp-for="FeeTermId" id="Feetermidtxt" value="@ViewBag.modellist[0].FeeTermId" />
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label space text-end required" for="basic-default-name">Fee Term</label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="TermName" class="form-control" id="TermNametxt" value="@ViewBag.modellist[0].TermName" />
                        <span asp-validation-for="TermName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label space text-end required" for="basic-default-name">Fee Types</label>
                    <div class="col-sm-4">
                        <select asp-for="FeeTypeId" class="form-select" id="lstfeetypes" multiple>

                            @foreach (var item in ViewBag.Feetype as SelectList)
                            {
                                bool isSelected = false;
                                @foreach (var itemss in ViewBag.UniqueConcedingTypeIds)
                                {
                                    @if (item.Value == itemss.Item1.ToString())
                                    {
                                        isSelected = true;
                                        break;
                                    }
                                }
                                @if (isSelected == true)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="FeeTypeId" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label space text-end" for="basic-default-name">Description</label>
                    <div class="col-sm-4">
                        <textarea class="form-control" asp-for="Description" rows="4" cols="50" id="descriptiontxt"></textarea>
                        <script>
                                    var description = '@Html.Raw(ViewBag.modellist[0].Description)'; // Get the description from ViewBag.modellist

                                    // Set the value of the textarea with ID "descriptiontxt"
                                    document.getElementById('descriptiontxt').value = description;
                        </script>
                    </div>
                </div>

                <div class="justify-content-center text-center">
                    <button type="button" class="btn btn-info waves-effect waves-light btn-sm" onclick="previouspages('ManageFeeTypes',null)">Previous Page</button>
                    <button type="button" class="btn btn-danger waves-effect waves-light btn-sm" id="btnDelete" onclick="Confirmdltall('@ViewBag.modellist[0].FeeTermId','')">Delete</button>
                    <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="updbacktosearchbtn">Back To Search</button>
                    <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Updatebtn">Update</button>
                    <button type="button" class="btn btn-primary waves-effect waves-light btn-sm" onclick="nextpages('ManageBankAccounts',null)">Next Page</button>
                </div>
            </form>
        </div>
    </div>
</div>



<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>

<script src="~/js/Managefeeterms1.js"></script>
