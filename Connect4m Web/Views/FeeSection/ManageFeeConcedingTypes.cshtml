@model Connect4m_Web.Models.Attendenceproperites.Feeconcedingtypes
@{
    ViewData["Title"] = "Manage Fee Conceding Types";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-2 text-center text-header">MANAGE FEE CONCEDING(DISCOUNT) TYPES</h4>
        <span id="Commonerrormessage" class="text-validation"></span>
        <div class="justify-content text-end">
            <button type="button" class="btn btn-label-linkedin waves-effect btn-sm" onclick="lnkAddNew(event)">
                Create Fee Discount Type
            </button>
        </div>
        <div class="row mb-2" id="SearchMaindiv">
            <div class="col-md-12 col-lg-12 mb-3">
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white text-header">SEARCH FEE DISCOUNT TYPES</div>
                    <div class="card-body">
                        <div class="row col">
                            <form class="form theme-form" id="Searchfeedescounttypesform">
                                <div class="row mb-3">
                                    <label class="control-label col-sm-4 col-form-label text-end  space">Fee Discount Type </label>
                                    <div class="col-sm-4">
                                        <input type="text" asp-for="ConcedingTypeName" id="Concedingtypenametxt" class="form-control">
                                    </div>
                                </div>
                                <div class="justify-content text-center">
                                    <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="clearForm('bankaccountsserform')" id="searbtnclear">Clear</button>
                                    <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="btnsearch">Search</button>
                                    <button type="submit" class="btn btn-primary waves-effect waves-light btn-sm" onclick="nextpages('ManageFeeTypes',null)">Next Page</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12 col-lg-12 mb-3">
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white text-header">
                        YOUR SEARCH RESULTED
                        <span id="Recordscount" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span>
                        RECORDS.
                    </div>
                    <table class="table table-bordered" id="Discounttbl">
                        <thead class="table-dark">
                            <tr>
                                <th>S.NO</th>
                                <th>Fee Discount Type</th>
                                <th>Amount</th>
                                <th>Description</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
        <div id="Addnew_div1">

        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.0/jquery-ui.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="~/js/ManageFeeConcedingtypes.js"></script>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
