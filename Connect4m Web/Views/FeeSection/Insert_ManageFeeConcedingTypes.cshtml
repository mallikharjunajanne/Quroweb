@model Connect4m_Web.Models.Attendenceproperites.Feeconcedingtypes

@{
    ViewData["Title"] = "Feeconcedingtypes";
    Layout = null;
}


<div class="col-md-12 col-lg-12 mb-3">
    <div class="card mb-4">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
            SAVE FEE DISCOUNT TYPE
            <small>* INDICATES MANDATORY FIELD</small>
        </div>
        <div class="card-body">
            <form class="form" id="Newdiscountfeetypeform">
                <div class="row mb-2">
                    <label asp-for="ConcedingTypeName" class="control-label col-sm-4 col-form-label text-end required space">Fee Discount Type </label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="ConcedingTypeName" id="ConcedingTypeNametxt" class="form-control">
                        <span asp-validation-for="ConcedingTypeName" class="text-danger"></span>
                        <input type="hidden" asp-for="ConcedingTypeId" id="ConcedingTypeIdtxtid" class="form-control" />
                    </div>
                </div>
                <div class="row mb-2">
                    <label asp-for="Amount" class="control-label col-sm-4 col-form-label text-end required space">Amount </label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="Amount" id="Amounttxt" class="form-control">
                        <span asp-validation-for="Amount" class="text-danger"></span>
                        <span id="AmountError" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label asp-for="Description" class="control-label col-sm-4 col-form-label text-end  space">Description </label>
                    <div class="col-sm-4">
                        <textarea asp-for="Description" id="Descriptiontxt" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="row justify-content text-center">
                    <div class="col-sm-12">
                        <button type="reset" class="btn btn-danger waves-effect waves-light" onclick="clearForm('Newdiscountfeetypeform')" id="btnclear">Clear</button>
                        <button type="button" class="btn btn-dark waves-effect waves-light" id="Svbacktosearchbtn">Back To Search</button>
                        <button type="submit" class="btn btn-success waves-effect waves-light">Save</button>
                        <button type="button" class="btn btn-primary waves-effect waves-light" onclick="nextpages('ManageFeeTypes',null)">Next Page</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>





<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>

<script src="~/js/ManageFeeConcedingtypes1.js"></script>
