<div class="default-according style-1">

    @*========================== SAVE LEAVE DELEGATION Card====================*@
    <div class="card mb-4" id="SearchPage">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
            <span>LEAVE DELEGATION</span>
            <small class="required">INDICATE REQUIRED FEILDS</small>
        </div>
        <div class="card-body">
            <form id="FmAddLeaveDelegationPage_SaveDetails">
                @*--------------------------*@
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label  text-end required" for="basic-default-name">Department</label>
                    <div class="col-sm-4 ">
                        <div class="position-relative">
                            <select id='DdlDepartment' class="select2 form-select select2-hidden-accessible" name="InstanceClassificationId" asp-items="@(new SelectList(""))">
                                <option value=''>---------Select---------</option>
                            </select>
                        </div>
                    </div>
                </div>

                @*--------------------------*@
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label  text-end required" for="basic-default-name">Role</label>
                    <div class="col-sm-4 ">
                        <div class="position-relative">
                            <select id='DdlRole' class="select2 form-select select2-hidden-accessible" name="RoleId" onchange="GetApprovingAuthorityUserName_BY_SelectRoleId()" asp-items="@(new SelectList(""))">
                                <option value=''>---------Select---------</option>
                            </select>
                        </div>
                    </div>
                </div>

                @*--------------------------*@
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label  text-end " for="basic-default-name">Approving Authority </label>
                    <div class="col-sm-4 ">
                        <div class="position-relative">
                            <select id='DdlUser' class="select2 form-select select2-hidden-accessible" name="Userid" asp-items="@(new SelectList(""))">
                                <option value=''></option>
                            </select>
                        </div>
                    </div>
                </div>

                @*--------------------------*@
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label  text-end " for="basic-default-name">Delegate To</label>
                    <div class="col-sm-4 ">
                        <span id="DelegationToName" style="color:red"></span>
                        <input type="hidden" name="DelegationId" id="HdnDelegationTo_UserId" />
                        &nbsp; <img id="ImgSelect" src="~/IconImages/ArrowMark.gif" />
                        <a id="LnkSelectUser" onclick="AddUserPage_PagePartialViewFunction()" style="font-weight:bold;cursor:pointer">Add User</a>
                    </div>
                </div>
                @*--------------------------*@
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label  text-end required" for="basic-default-name">From Date</label>
                    <div class="col-sm-4 ">
                        <input type="date" class="form-control" id="TxtFromDate" name="Fromdate" />
                    </div>
                </div>

                @*--------------------------*@
                <div class="row mb-2">
                    <label class="col-sm-4 col-form-label  text-end required" for="basic-default-name">To Date</label>
                    <div class="col-sm-4 ">
                        <input type="date" class="form-control" id="TxtToDate" name="Todate" />
                    </div>
                </div>

                @*--------------------------*@
                <input type="hidden" id="HdnLeaveDelegationId" name="LeaveDelegationId" />

                @*--------------------------*@

                @*--------------------------*@
                <div class="text-center">
                    <button type="button" class="btn btn-info waves-effect waves-light btn-sm" id="BtnBack" onclick="BackTOSearhLeaveTypes('FmAddLeaveDelegationPage_SaveDetails')" value="Back">Back</button>
                    <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="BtnClearSearchForm" onclick="FN_ClearValuesDeleigation('FmAddLeaveDelegationPage_SaveDetails')" value="Clear">Clear</button>
                    <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="BtnSaveId" onclick="SaveLeavedelegation(event)" value="Save">Save</button>
                </div>
                @*--------------------------*@
            </form>
        </div>
    </div>
</div>



