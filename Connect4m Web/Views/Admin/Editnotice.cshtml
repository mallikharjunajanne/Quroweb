@model Connect4m_Web.Models.Attendenceproperites.UserScreen.Managenoticesinsert
@{
    ViewData["Title"] = "Edit Notice";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = null;
}

<div class="col-md-12 col-lg-12 mb-3">
    <div class="card mb-4">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
            UPDATE NOTICE
            <small class="text-header-small">* INDICATES MANDATORY FIELDS.</small>
        </div>
        <div class="card-body">
            <form id="Updatenoticetypeform" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row mb-2">
                    <label class="control-label col-sm-4 col-form-label text-end required space">Notice Type</label>
                    <div class="col-sm-4">
                        <select id="Enoticetypeddlid" asp-for="ENoticeTypeId" class="form-select select2 form-select select2-hidden-accessible">
                            @foreach (var item in ViewBag.Enoticetypeddl)
                            {
                                @*<option value="@(item.Value == ViewBag.Enoticetypeid ? "selected" : "" )">@item.Text</option>*@
                                <option value="@item.Value" selected="@(item.Value == ViewBag.Enoticetypeid)">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="ENoticeTypeId" class="text-danger Validation"></span>
                        <input type="hidden" asp-for="ENoticeId" class="form-control" id="Enoticetxtid" />
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="control-label col-sm-4 col-form-label text-end required space">Notice Subject</label>
                    <div class="col-sm-4">
                        <textarea id="Subjecttxtid" asp-for="Subject" class="form-control" maxlength="1000" oninput="CharCount()" onkeydown="return preventSpecialCharacters(event)"></textarea>
                        <span id="charCounts" style="font-size: 12px;"></span>
                        <span id="Characterslengths" style="font-size: 12px;"></span>
                        <span asp-validation-for="Subject" class="text-danger Validation"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="control-label col-sm-2 col-form-label text-end space"> <b>NOTE </b></label>
                    <div class="col-sm-10">
                        Invalid Characters in sending SMS: % & < >
                        Some Characters like ` ~ ^ + $ may not deliver properly to all mobiles.
                        Messages sent between 9PM and 9AM will be delivered after 9AM
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="control-label col-sm-4 col-form-label text-end  space">Description</label>
                    <div class="col-sm-4">
                        <textarea asp-for="ENoticeDescription" id="Enoticedescriptiontxt" class="form-control" maxlength="6500" oninput="Charactercount()"></textarea>
                        <span asp-validation-for="ENoticeDescription" class="text-danger Validation"></span>
                        <span id="DescriptionCharacters" style="font-size: 12px;"></span>
                        <span id="Characterlengths" style="font-size: 12px;"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="control-label col-sm-4 col-form-label text-end required space">Start Date</label>
                    <div class="col-sm-4">
                        <input type="date" asp-for="StartDate" id="Stdatetxt" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger Validation"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="control-label col-sm-4 col-form-label text-end required space">End Date(Expiry Date)</label>
                    <div class="col-sm-4">
                        <input type="date" asp-for="ExpiryDate" id="Exdatetxt" class="form-control" />
                        <span asp-validation-for="ExpiryDate" class="text-danger Validation"></span>
                        <span id="DateCompareErrormessage" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="control-label col-sm-4 col-form-label text-end  space">Upload Notice document</label>
                    <div class="col-sm-4">
                        @if (string.IsNullOrEmpty(Model.NoticeDocument))
                        {
                            <input type="file" id="AttachedDocument" asp-for="NoticeDocument" name="NoticeDocument" class="form-control" /> }
                        else
                        {
                            <div>
                                <label id="AttachedDocumentName" name="NoticeDocumentName" value="@Model.NoticeDocument">@Model.NoticeDocument</label>
                                <button type="button" id="deleteDocumentBtn" class="btn btn-danger btn-xs">Delete</button>
                            </div>
                            <div id="fileUploadSection" style="display:none;">
                                <label>Upload New Document:</label>
                                <input type="file" id="AttachedDocument" name="NewDocument" class="form-control" />
                            </div>
                        }
                    </div>
                </div>
                <div class="row mb-2" id="NoticeDisplaylogindivid">
                    <label class="control-label col-sm-4 col-form-label text-end required space">Display this Notice in Login </label>
                    <div class="col-sm-4">
                        <div class="radio radio-primary">
                            <input id="radio55" type="radio" asp-for="ShowInLogin" name="radio1" value="0" checked>
                            <label class="mb-0" for="radio55">No</label>
                            <input id="radio55" type="radio" asp-for="ShowInLogin" name="radio1" value="1">
                            <label class="mb-0" for="radio55">Yes</label>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12 text-center">
                    <button class="btn btn-danger waves-effect waves-light btn-sm" onclick="DeleteUpdatednotice()" id="Deletebtn">Delete</button>
                    <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="UpdateBacktosearchbtn">Back To Search</button>
                    <button type="submit" class="btn btn-info waves-effect waves-light btn-sm" id="UpdatePostnoticebtn">Post this Notice</button>
                    <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Updatesubmitbtn">Update</button>
                    <button type="submit" class="btn btn-primary waves-effect waves-light btn-sm" id="Updateandpostbtn">Save and Post</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/Managenoticeupdate.js"></script>




@*<script src="~/js/Managenotices_2.js"></script>*@
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



<script>
    $(document).ready(function () {
        $('#deleteDocumentBtn').click(function () {
           
            // After successful deletion, show the file upload section
            $('#fileUploadSection').show();

            // Hide the current document display section
            $('#AttachedDocumentName').parent().hide();
        });
    });
</script>