@model Connect4m_Web.Models.Attendenceproperites.UserScreen.SearchDeposit

@{
    ViewData["Title"] = "AMOUNT DEPOSIT REPORT";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <style>
        #Bankdeposittbldivid tbody td {
            border: 1px solid black; /* Border style */
            border-collapse: collapse; /* Border collapse */
        }
        #Bankdeposittbldivid tfoot td {
            border: 1px solid black; /* Border style */
            border-collapse: collapse; /* Border collapse */
        }
    </style>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="text-center text-header">AMOUNT DEPOSIT REPORT</h4>
        <span id="CommonErrorMessage" class="text-validation"></span>
        <div class="row mb-2">
            <div class="col-md-12 col-lg-12">
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white text-header">SEARCH</div>
                    <div class="card-body">
                        <form id="Amountdepositreportform" enctype="multipart/form-data">
                            <div class="row col">
                                <div class="row mb-3">
                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label space text-end" for="basic-default-name">Start Date</label>
                                        <div class="col-sm-4">
                                            <input type="date" asp-for="StartDate" class="form-control" id="Startdate_txtid">
                                        </div>
                                        <label class="col-sm-2 col-form-label  text-end" for="basic-default-name">End Date</label>
                                        <div class="col-sm-4">
                                            <input type="date" asp-for="EndDate" class="form-control" id="Enddate_txtid">
                                        </div>
                                    </div>
                                </div>
                                <div class="row justify-content-center text-center">
                                    <div class="col-sm-12">
                                        <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="BtnClear" onclick="Searchclear('Amountdepositreportform')">Clear</button>
                                        <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Btnsearch">Search</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-12 col-lg-12">
                <div class="row">
                    <div class="">
                        <div class="row">
                            <div class="row">
                                <div class="col-11">
                                    <a href="javascript:void(0)" id="Amountdepositreport_ExportToExcel" class="btn btn-label-linkedin waves-effect btn-sm text-end">Export to Excel</a>
                                </div>  
                                <div class="col-1 text-end">
                                    <a href="javascript:void(0)" id="Amountdepositreport_Print" class="btn btn-label-linkedin waves-effect btn-sm">Print</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header bg-danger text-white text-header">
                        YOUR SEARCH RESULTED
                        <span id="Recordscount" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span>
                        RECORDS
                    </div>
                    <div class="table-responsive text-wrap">
                        @*<table class="table table-hover" id="Bankdeposittbldivid">*@
                        <table class="table table-hover table-bordered no-footer dataTable" id="Bankdeposittbldivid">
                            <thead class="table-dark">                               
                                <tr>
                                    <th>School Name</th>
                                    <th>Deposit Date</th>
                                    <th>Deposit Amount</th>
                                    <th>Bank Name</th>
                                    <th>Branch Name</th>
                                    <th>Document Name</th>
                                    <th>Payment Mode</th>
                                </tr>
                            </thead>
                            <tfoot id="Bankdeposittblfooter" style="display:none;">
                               <tr class="even">
                                    <td colspan="2">Total</td>
                                    <td><span id="Totalamountsid"></span></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>


<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.0/jquery-ui.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    function TblCallToAjax(method, url, data, successCallback, errorCallback) {
        $.ajax({
            url: url,
            type: method,
            data: data,
            // success: Datatablesbindingfun,
            success: function (response) {
                successCallback(response);
            },
            error: function (xhr, status, error) {
                errorCallback(xhr.status, error);
            }
        });
    }
    $(document).ready(function () {
        //debugger;
        //Date feilds showing function
        setMonthStartEndDates();

        //Table data binding function
        Bankdeposittablebindingfun();
    });

    // TABLE DATA BINDING IN THIS FUNCTION
    function Bankdeposittablebindingfun() {
        var formData = $('#Amountdepositreportform').serialize();
        //debugger;
        TblCallToAjax('GET', '/Reports/Depositreporttbl', formData,
            function (response) {
                Tabledatabindingfun(response);
            },
            function (status, error) {
                $('#Commoneerrormessage').text('Something went wrong  in table data binding function...!!!!');
            }
        );
    }

    //TABLE DATA BINDING FUNCTION
    function Tabledatabindingfun(response) {
        //debugger;
        var today = new Date(); // Get the current date
        var formattedDate = DateFormate(today);
        var startDate = $('#Startdate_txtid').val();
        var endDate = $('#Enddate_txtid').val();

        // Ensure start and end dates are formatted correctly
        startDate = startDate ? startDate.replace('/', '-') : '';
        endDate = endDate ? endDate.replace('/', '-') : '';
        var table = $('#Bankdeposittbldivid').DataTable();
        table.destroy();

        $("#Recordscount").text(response.length);
        if (response.length === 0) {
            $('#Bankdeposittblfooter').hide();
        }
        else {
            $('#Bankdeposittblfooter').show();
        }

        var totalDepositAmount = 0;
        for (var i = 0; i < response.length; i++) {
            var depositAmount = parseFloat(response[i].depositAmount);
            if (!isNaN(depositAmount)) {
                totalDepositAmount += depositAmount;
            }
        }
        var newTable = $("#Bankdeposittbldivid").DataTable({
            dom: '<"top"lf>t<"bottom"ip>',
            buttons: [],
            bProcessing: false,
            bLengthChange: false,
            /*  lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "ALL"]],*/
            bfilter: true,
            bSort: false,
            searching: false,
            //scrollX: true,
            //scrollY: '400px',
            /* scrollCollapse: true,*/
            paging: false,
            bPaginate: false,
            //  stateSave:true,
            data: response,
            columns: [
                {
                    data: "School Name",
                    render: function (data, type, row, meta) {
                        return row.schoolName
                    }
                },
                {
                    data: "Deposit Date",
                    render: function (data, type, row, meta) {
                        return row.depositdate
                    }
                },
                {
                    data: "Deposit Amount",
                    render: function (data, type, row, meta) {
                        return row.depositAmount
                    }
                },
                {
                    data: "Bank Name",
                    render: function (data, type, row, meta) {
                        return row.bankName
                    }
                },
                {
                    data: "Branch Name",
                    render: function (data, type, row, meta) {
                        return row.branchName
                    }
                },
                {
                    data: "Document Name",
                    render: function (data, type, row, meta) {
                        return row.documentName
                    }
                },
                {
                    data: "Payment Mode",
                    render: function (data, type, row, meta) {
                        return row.paymentMode
                    }
                }
            ],
        });
        newTable.$('tbody').addClass('bordered-table-body');
        $('#Totalamountsid').text(totalDepositAmount);
    }


    // Function to compare dates and show error message
    function DatesCompare(Sdate, Edate) {
        try {
            //debugger;
            var StartdateInput = $("#Startdate_txtid").val();
            var EnddateInput = $("#Enddate_txtid").val();

            var Startdate = new Date(StartdateInput);
            var Enddate = new Date(EnddateInput);

            var errorElement = $('#CommonErrorMessage');

            errorElement.text("");

            if (Enddate <= Startdate) {
                errorElement.text(Sdate + " cannot be greater than " + Edate + ".");
            } else {
                errorElement.text("");
            }
        } catch (error) {
            console.log(error);
        }
    }

    // Dates input change Event
    $("#Startdate_txtid").on("change", function () { DatesCompare("Start date", "end date"); });
    $("#Enddate_txtid").on("change", function () { DatesCompare("Start date", "end date"); });

    //SEARCH  FUNCTION
    $('#Amountdepositreportform').on("submit", function () {
        //debugger;
        event.preventDefault();
        event.stopPropagation();
        $('#Commoneerrormessage').text('');
        var StartdateInput = $("#Startdate_txtid").val();
        var EnddateInput = $("#Enddate_txtid").val();

        var Startdate = new Date(StartdateInput);
        var Enddate = new Date(EnddateInput);

        var errorElement = $('#CommonErrorMessage');
        errorElement.text("");
        var isvalid = true;
        if (Enddate <= Startdate) {
            errorElement.text("Start date cannot be greater than end date.");
            isvalid = false;
        }
        else {
            errorElement.text("");
        }

        if (isvalid) {
            var formData = $('#Amountdepositreportform').serialize();
            TblCallToAjax('GET', '/Reports/Depositreporttbl', formData,
                function (response) {
                    Tabledatabindingfun(response);
                },
                function (status, error) {
                    $('#Commoneerrormessage').text('Error in table data binding function, please check.');
                }
            );
        }
    });

    // Function to get the first day of the month
    function getFirstDayOfMonth(date) {
        //debugger;
        return new Date(date.getFullYear(), date.getMonth(), 1);
    }

    // Function to get the last day of the month
    function getLastDayOfMonth(date) {
        //debugger;
        return new Date(date.getFullYear(), date.getMonth() + 1, 0);
    }

    // Function to set Start Date and End Date inputs to current month's first and last dates
    function setMonthStartEndDates() {
        //debugger;
        var today = new Date();
        var firstDayOfMonth = getFirstDayOfMonth(today);
        var lastDayOfMonth = getLastDayOfMonth(today);

        $("#Startdate_txtid").val(DateFormate(firstDayOfMonth));
        $("#Enddate_txtid").val(DateFormate(lastDayOfMonth));
    }

    // Function to format date as 'YYYY-MM-DD'
    function DateFormate(date) {
        var year = date.getFullYear();
        var month = (date.getMonth() + 1).toString().padStart(2, '0');
        var day = date.getDate().toString().padStart(2, '0');
        return year + '-' + month + '-' + day;
    }

    //======>>>> EXPORT TO EXCEL FUNCTION CODE START
    $('#Amountdepositreport_ExportToExcel').on('click', function () {
       //debugger;
        var today = new Date(); // Get the current date
        var formattedDate = DateFormate(today);
        var startDate = $('#Startdate_txtid').val();
        var endDate = $('#Enddate_txtid').val();
        var headerContent = `
                             <div style="display: grid; grid-template-columns: repeat(18, 1fr);">
                                 <div style="grid-column: 1 / span 18;">
                                      <h5 style="margin: 0; text-align: center;">Fee Amount Deposit </h5>
                                      <h5 style="margin: 0; text-align: center;">Report On:${formattedDate}</h5>
                                      <h5 style="margin: 0; text-align: center;">Start Date: ${startDate.replace('/', '-')}</h5>
                                      <h5 style="margin: 0; text-align: center;">End Date: ${endDate.replace('/', '-')}</h5>
                                 </div>
                             </div>`;
        var table1 = document.getElementById("Bankdeposittbldivid");
        var table1Clone = table1.cloneNode(true);
        var clonedTbody = table1Clone.getElementsByTagName("tbody")[0];
        var tdElements = clonedTbody.getElementsByTagName("td");
        for (var i = 0; i < tdElements.length; i++) {
            tdElements[i].style.border = "1px solid black"; // Adjust border styles as needed
        }

        var FooterContent = `<div style="grid-column: 1 / span 10; background-color: #e0e0e0; padding: 20px; border-radius: 5px;">
                               <p style="margin: 0; text-align: center;font-size: 9px;">This report contains confidential information intended solely for the recipient. Unauthorized use, copying, or distribution is strictly prohibited.</p>
                             </div>`;
        document.body.appendChild(table1Clone);
        var combinedHtml = headerContent + table1Clone.outerHTML + FooterContent;
        const blob = new Blob([combinedHtml], { type: 'application/vnd.ms-excel' });
        saveAs(blob, 'FeeAmountDepositReport.xls');
        table1.parentNode.replaceChild(table1Clone, table1);
    });

    //=====>>>> PRINT
    $('#Amountdepositreport_Print').on('click', function () {
        //debugger;
        var printContents = $('#Bankdeposittbldivid').prop('outerHTML');
        // Create a new window to print the content
        var printWindow = window.open('', '_blank');
        printWindow.document.write('<html><head><title></title>');
        printWindow.document.write('<style>');
        printWindow.document.write('table, th, td { border: 1px solid black; border-collapse: collapse; }'); // Collapse borders
        printWindow.document.write('</style></head><body>');
        printWindow.document.write(printContents);
        printWindow.document.write('</body></html>');
        printWindow.document.close(); // Close the document opened with document.write
        printWindow.print();
    });


    //=====>>>> COMMON CLEAR
    function Searchclear(formid) {
        //debugger;
        // Retrieve the form element by id
        var form = document.getElementById(formid);

        if (form) {
            // Use the reset method to clear the form
            form.reset();
            $('#Commoneerrormessage').text('');
            // Clear ASP.NET Core validation messages
            var validationSpans = form.querySelectorAll('span[data-valmsg-for]');
            validationSpans.forEach(span => {
                span.textContent = ''; // Clear validation messages
            });

        } else {
            console.error("Form with id '" + formid + "' not found.");
        }
    }
   

</script>
