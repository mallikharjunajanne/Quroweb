@model Connect4m_Web.Models.Attendenceproperites.UserScreen.CoolLinks
@{
    Layout = null;
}

<div class="card">
    <div class="card-header bg-danger text-white text-header d-flex align-items-center justify-content-between">
        SAVE COOL LINK<small class="text-header-small">* INDICATES MANDATORY FIELDS.</small>
    </div>
    <div class="card-body">
        <div class="row col">
            <form id="Insertform" enctype="multipart/form-data">
                <div class="row mb-3">
                    <label class="control-label col-sm-4 col-form-label required text-end space" asp-for="Name">Cool Link Name</label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="Name" name="Name" id="Nametxt" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="control-label col-sm-4 col-form-label required text-end space" asp-for="Url">Cool Link URL</label>
                    <div class="col-sm-4">
                        <input type="url" asp-for="Url" name="Url" id="Urltxt" class="form-control" />
                        <span asp-validation-for="Url" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="control-label col-sm-4 col-form-label text-end space">Description</label>
                    <div class="col-sm-4">
                        <textarea asp-for="Description" name="Description" id="InsertDescriptiontxt" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-12 text-center">
                    <button type="button" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Clearfun('Insertform', 'Validationmessage')" id="Clearbtn">Clear</button>
                    <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="Backtosearchbtn">BackToSearch</button>
                    <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Insertbtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- jQuery Validation -->
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>

<script src="~/js/Coollinks1.js"></script>