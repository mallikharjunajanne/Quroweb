@model Connect4m_Web.Models.Attendenceproperites.UserScreen.ManageClassification
@{
   ViewData["Title"] = "Manage Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl" id="Managedepartmentmaindiv">    
        <h4 class="mb-2 text-center text-header">MANAGE DEPARTMENT </h4>  
        <div class="row mb-2" id="Searchuserfields_tabledatadiv1">
            <div class="justify-content text-end" id="Manageholidays_Heaingmaindiv0">
                <button type="button" class="btn btn-label-linkedin waves-effect btn-sm" id="Addnewdepartmentbtn">Create Department</button>
            </div>
            <div id="Manageclassificationmaindiv">
                <div class="col-md-12 col-lg-12 mb-3">
                    <div class="card mb-4">
                        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">SEARCH DEPARTMENT</div>
                        <div class="card-body">
                            <form class="form" id="Searchdepartmentform">
                                <div class="row mb-3">
                                    <label class="control-label col-sm-4 col-form-label text-end space">Department Name </label>
                                    <div class="col-sm-4">
                                        <input type="text" class="form-control" name="DepartName" id="DepartName_txtid" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="control-label col-sm-4 col-form-label text-end space">Description </label>
                                    <div class="col-sm-4">
                                        <textarea class="form-control" id="Descriptiontxtid"></textarea>
                                    </div>
                                </div>
                                <div class="row justify-content text-center">
                                    <div class="col-sm-12">
                                        <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Clearform('Searchdepartmentform')" id="Mainview_Clearbtn">Clear</button>
                                        <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="Mainview_Searchbtn">Search</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="Manageclassification_containerdivId">
                    <span id="Errmsg" class="text-danger text-validation"></span>
                    <div class="col-md-12 col-lg-12 mb-3">
                        <div class="card mb-4">
                            <div class="card-header bg-danger text-white text-header">
                                YOUR SEARCH RESULTED
                                <span id="Classification_Recordscount" class="badge badge-center rounded-pill bg-primary bg-glow"></span>
                                RECORDS.
                            </div>
                            <table class="table table-bordered" id="ManageClassificationtbl">
                                <thead class="table-dark">
                                    <tr>
                                        <th>SNO</th>
                                        <th>Department</th>
                                        <th>Description</th>
                                        <th>Delete</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>


            <div id="Manageclassification_Insertdiv2"></div>

            <div id="Manageclassification_Updatediv3"></div>
        </div>
    </div>
</body>
</html>



<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>
<script src="~/js/Manageclassification.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>