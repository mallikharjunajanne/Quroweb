
@{
    ViewData["Title"] = "SectionwiseAttendanceReporttbldata";
    Layout = null;
}


<div class="row mb-2">
    <div class="row justify-content" style=" color: #7367f0;">
        <div class="col-sm-6" id="Reporttblexporttoexcel">
            <a herf="Javascript:void(0);" id="_AttendancereportExportExcel" class="btn btn-label-linkedin waves-effect btn-sm">Export To Excel</a>
        </div>
        <div class="col-sm-6 text-end" id="reporttblprint">
            <a herf="javascript:void(0);" id="_attendancereportPrint" class="btn btn-label-linkedin waves-effect btn-sm">Print</a>
        </div>
    </div>
    <div class="col-md-12 col-lg-12 mb-3">
        <div class="card mb-4">
            <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
                <span id="AddNewText_Span_CreatePage">
                    ATTENDANCE DETAILS
                </span>
            </div>

            <div class="card-datatable text-nowrap">
                <div class="table-responsive">
                    <div class="table-responsive text-nowrap" id="Printattendancereport">
                        <div style=" text-align: center; font-weight: 500;">
                            <b>Quro Schools</b>
                            <p>Attendance for the Classes <span id="Selectedepartmentspid"></span> for the period of <span id="Fromdatespid"></span> To <span id="Enddatespid"></span></p>
                        </div>
                        <table class="table table-bordered" id="SectionwiseattendaceReport" style="border-collapse: separate;">
                            <thead id="tablehead" class="table-dark">

                            </thead>
                            <tbody id="tableBody">
                            </tbody>
                        </table>
                        <div id="AttendanceSignaturesdiv">

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/GeneralFunctions.js"></script>
@*<script src="~/js/Monthwiseclassattendancereport.js"></script>*@
<script src="~/js/SectionwiseAttendanceReport.js"></script>
