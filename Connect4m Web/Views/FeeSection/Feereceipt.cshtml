<script>
    function CallToAjax(method, url, successCallback, errorCallback) {
        $.ajax({
            url: url,
            type: method,
            success: successCallback,
            error: function (xhr, status, error) {
                errorCallback(xhr.status, error);
            }
        });
    }
    function handleAjax(method, url, data, successCallback, errorCallback, hasFileUpload) {

        var ajaxOptions = {
            url: url,
            method: method,
            data: data,
            success: successCallback,
            error: function (xhr, status, error) {
                errorCallback(xhr.status, error);
            }
        };

        if (hasFileUpload) {
            ajaxOptions.processData = false;
            ajaxOptions.contentType = false;
        }

        $.ajax(ajaxOptions);
    }

    $(document).ready(function () {

        debugger;
        //$('#Searchresiltstbl_Divid1').hide();
        //$('#Feetermsdetails_Divid2').hide();
        //$('#Challanauserdetails_Divid3').hide();

        fetchDataAndPopulateDropdown(                           //==== << ** Classification Dropdown ** >>
            '/FeeSection/Frclassificationddlbinding',           // URL for data fetching
            '#Ddldepartment',                                   // Dropdown selector
            'value',                                            // Field name for option text
            'text',                                             // Field name for option values
            ' '                              // Response value return class name
        );

    });

    function fetchDataAndPopulateDropdown(url, selector) {
        // Fetch data and populate dropdown (dummy implementation, replace with actual code)
        $.ajax({
            url: url,
            method: 'GET',
            success: function (data) {
                var dropdown = $(selector);
                dropdown.empty();
                dropdown.append($('<option>', {
                    value: '',
                    text: '---Select---'
                }));
                $.each(data, function (index, item) {
                    dropdown.append(new Option(item.text, item.value));
                });
            }
        });
    }
   
    $('#Ddldepartment').change(function () {
        var ClassificationId = $('#Ddldepartment').val();
        Departmentbysubclassdd(ClassificationId);
    });
    function Departmentbysubclassdd(Departmentvalue) {
        fetchDataAndPopulateDropdown(                                             //==== << ** Subclassification Dropdown ** >>
            '/FeeSection/FrSubclassddlbinding?InstanceClassificationId=' + Departmentvalue,// URL for data fetching
            '#DdlClass',                                                          // Dropdown selector
            'value',                                                              // Field name for option text
