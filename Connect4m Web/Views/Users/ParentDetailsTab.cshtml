    @*--- Parent Details Table Card----*@
<div class="card" id="DivTblParentsSearchresults">
    <div class="card-datatable table-responsive pt-0">
        <div class="card-header bg-danger text-white">
            YOUR SEARCH RESULTED &nbsp;<span id="TblParentCounts" class="badge badge-center rounded-pill bg-primary bg-glow">0</span>  RECORD(S).
        </div>
        <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper dt-bootstrap5 no-footer">
            @if (@ViewBag?.UserId != null && @ViewBag?.UserId != 0)
            {
                <div class="text-end">
                    <button class="btn btn-label-linkedin waves-effect btn-sm" id="BtnAddNewParents" onclick="MoveTonextpage('CreateNewParents',null)">Add New</button>
                </div>
            }
            <table class="datatables-basic table dataTable no-footer dtr-column link" id="TblParentsSearchresults" style="display:none">
                <thead class="table-dark">
                    <tr>
                        <th>S.No</th>
                        <th>Parent Name</th>
                        <th>Relationship</th>
                        <th>Mobile Number</th>
                        <th>SMS Status</th>
                        <th>Login Status</th>
                        @*<th>Edit</th>*@
                        <th>Make Primary Contact</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

