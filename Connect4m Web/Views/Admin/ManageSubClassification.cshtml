@model Connect4m_Web.Models.Attendenceproperites.UserScreen.ManageSubClassification
@{
    ViewData["Title"] = "Manage SubClassification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>

</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-2 text-center">MANAGE CLASS </h4>
        <div class="row mb-2" id="Searchuserfields_tabledatadiv1">
            <div class="text-end" id="Manageholidays_Heaingmaindiv0">
                <button class="btn btn-label-linkedin waves-effect btn-sm" id="addnewsubclass">Create Class</button>
            </div>
            <span id="Commonerrormessage" class="text-danger text-validation"></span>
            <div id="ManageSubclassification_Containermaindiv">
                <div class="col-md-12 col-lg-12 mb-3">
                    <div class="card mb-4">
                        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">SEARCH CLASS</div>
                        <div class="card-body">
                            <form id="Classificaitionformid">
                                <div class="row mb-2">
                                    <label class="control-label col-sm-4 col-form-label text-end space">Department </label>
                                    <div class="col-sm-4">
                                        <select asp-for="InstanceClassificationId" id="ddldepartmentid" class="select2 form-select select2-hidden-accessible">
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="control-label col-sm-4 col-form-label text-end space">Class Name </label>
                                    <div class="col-sm-4">
                                        <input type="text" asp-for="SubClassificationName" id="txtclassid" class="form-control" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="control-label col-sm-4 col-form-label text-end space">Description </label>
                                    <div class="col-sm-4">
                                        <textarea class="form-control" asp-for="SubClassificationDescription" id="txtdescrid"></textarea>
                                    </div>
                                </div>
                                <div class="row justify-content text-center">
                                    <div class="col-sm-12">
                                        <button type="reset" class="btn btn-danger waves-effect waves-light" onclick="Clearcommonfunction('Classificaitionformid', null)" id="btnclear">Clear</button>
                                        <button type="button" class="btn btn-success waves-effect waves-light" id="btnsearch">Search</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>



                <a href="javascript:void(0)" id="exportToExcel" class="btn btn-label-linkedin waves-effect btn-sm">Export To Excel</a>               
                <div class="col-md-12 col-lg-12 mb-3">
                    <span id="Errmsg" class="text-danger text-validation"></span>
                    <div class="card mb-4">
                        <div class="card-header bg-danger text-white">
                            YOUR SEARCH RESULTED <span id="Subclassification_Recordscount" class="badge badge-center rounded-pill bg-primary bg-glow"></span> RECORDS.
                        </div>
                        <table class="table table-bordered" id="ManageSubclassificationtbl">
                            <thead class="table-dark">
                                <tr>
                                    <th>SNO</th>
                                    <th>Class</th>
                                    <th>Department</th>
                                    <th>Description</th>
                                    <th>Class Teacher Name</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            <div id="ManagesubclassificationInsertUpdatediv">

            </div>
        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.0/jquery-ui.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="~/js/ManageSubclassification.js"></script>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


