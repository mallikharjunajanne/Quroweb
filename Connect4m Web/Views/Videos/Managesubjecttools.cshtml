@model Connect4m_Web.Models.LMSproperties.Managesubjecttools
@{
    ViewData["Title"] = "Manage Subject Tools";
    //Layout = null;
}

<html>
<head>
    <title>@ViewData["Title"]</title>
    <link href="~/Datatable/jquery.dataTables.css" rel="stylesheet" />
    <link href="~/css/texts.css" rel="stylesheet" />
    <link href="~/css/Managesubjecttools.css" rel="stylesheet" />
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-3 text-center text-header">BULK UPLOAD SUBJECTS</h4>
        <div class="col-sm-12 text-end">
            <button type="button" class="btn btn-label-linkedin waves-effect btn-sm" id="Subjecttoolcreatebtn"> Create Subject Tool</button>
        </div>
        <div id="SUBJECTOOLSMAINDIV">
            <div class="card mb-3">
                <div class="default-according style-1" id="accordionoc">
                    <div class="card-header bg-danger text-white text-header d-flex align-items-center justify-content-between">SEARCH FOR SUBJECT TOOLS</div>
                    <div class="card-body">
                        <div class="collapse show" id="collapseicon" aria-labelledby="collapseicon" data-bs-parent="#accordionoc">
                            <div class="row padding-search">
                                <div class="row mb-3">
                                    <label class="control-label col-sm-4 col-form-label text-end space">Notice Subject</label>
                                    <div class="col-sm-4">
                                        <input type="text" id="subject_tool_name" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-sm-12 text-center">
                                    <button class="btn btn-danger waves-effect waves-light btn-sm" id="mst_clear">Clear</button>
                                    <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="mst_search">Search</button>
                                </div>
                                @*<div class="col-lg-3"><lable> Subject Tool Name</lable></div>
                                    <div class="col-lg-4">
                                    <input type="text" id="subject_tool_name" class="form-control" />
                                    </div>
                                    </div>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12 col-lg-12 mb-1">
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white">
                        YOUR SEARCH RESULTS <span id="totalrecords_subtools" class="badge badge-center rounded-pill bg-primary bg-glows"></span> RECORD(S)
                    </div>

                    <div id="eg1" style="color: black; background-color: whitesmoke">
                        <table class=" table table-bordered" id="tblsubjecttools" style="background-color:whitesmoke ;width:9px;border-color:red">
                            <thead style="width:9px;">
                                <tr style="border-color: black;">
                                    <th style="width: 9px; border-color: blue" class="bg-primary" hidden>
                                        Instance Subject ToolId
                                    </th>
                                    <th style=" width: 30%; border-color: blue" id="th2tool" class="bg-primary">
                                        Subject Tool Name
                                    </th>
                                    <th class="bg-primary" style="border-color: blue;" id="th3description">
                                        Description
                                    </th>
                                    <th style="width: 8px; border-color: blue;" id="th4delete" class="bg-primary">
                                        Delete
                                    </th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div id="SUBJECTTOOLSAPPENDINGDIV">

        </div>
    </div>

</body>
</html>



<script src="~/lib/jquery/dist/jquery.js"></script>
@*<script src="https://code.jquery.com/jquery-3.6.2.min.js" integrity="sha256-2krYZKh//PcchRtd+H+VyyQoZ/e3EcrkxhM8ycwASPA=" crossorigin="anonymous"></script>*@

<script src="~/Datatable/jquery.dataTables.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/Searchsubjecttools.js"></script>