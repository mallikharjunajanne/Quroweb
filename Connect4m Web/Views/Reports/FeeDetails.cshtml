@model Connect4m_Web.Models.Attendenceproperites.ReportFeedetails
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-2 text-center text-header">FEE DETAILS</h4>
        <div class="row mb-2">
            <div class="col-md-12 col-lg-12 mb-3">
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
                        SEARCH FEE DETAILS
                        <small class="text-header-small">* INDICATES MANDATORY FIELD</small>
                    </div>
                    <div class="card-body">
                        <form id="Feedetailform" enctype="multipart/form-data">
                            <div class="row mb-2">
                                <label for="lstTerms" class="control-label col-sm-4 col-form-label text-end  space">Terms</label>
                                <div class="col-sm-4">
                                    <select multiple="" class="form-select" id="lstTerms" aria-label="Multiple select example" asp-for="FeeTermId">
                                    </select>
                                    <span asp-validation-for="FeeTermId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm-12 text-center">
                                <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="BtnClear" onclick="Searchclearfun('Feedetailform')">Clear</button>
                                <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="Btnsearch">Search</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-12 col-lg-12 mb-3" id="Paymentoptionchangediv" style="display:block;">
                <div class="text-right">
                    <a href="javascript:void(0)" class="btn rounded-pill btn-info waves-effect waves-light btn-sm" id="Exporttoexcellnk">Export To Excel</a>
                </div>
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
                        FEE SUMMARY
                    </div>
                    <!--Example-->
                    <div id="Feesummarytbls"></div>
                    <span id="Feesummarytblamountcountspid" style="color:green;"></span>
                    <!--Example-->
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/Feedetails.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>




