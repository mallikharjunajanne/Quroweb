@model Connect4m_Web.Models.Attendenceproperites.UserScreen.Studentattendancepost
@{
    ViewData["Title"] = "Post Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    @*<link href="~/css/PostAttendance.css" rel="stylesheet" />*@
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-3 text-center text-header">POST ATTENDANCE </h4>
        <div class="row mb-2">
            <div class="col-md-12 col-lg-12 mb-3">
                <span id="Errormessage" class="text-validation"></span>
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white text-header d-flex align-items-center justify-content-between">
                        SEARCH FOR STUDENTS<small class="text-header-small">* INDICATES MANDATORY FIELD</small>
                    </div>
                    <div class="card-body">

                        @*=============================  Form Start ================================*@
                        <form id="Serach_MA" class="needs-validation was-validated" novalidate>

                            <div class="row">
                                <div class="col">
                                    <input type="hidden" id="ROLENAMESPANID" value="@ViewBag.rolename" />

                                    @*=====================        TEXT BOX                 =================*@

                                    <div class="row mb-3">
                                        <label class="control-label col-sm-4 col-form-label text-end required space" id="RlStartdate" for="basic-default-name" asp-for="StartDate"></label>
                                        <div class="col-sm-4 form-group">
                                            <input type="date" class="form-control" id="StartDateid" asp-for="StartDate" required>
                                            <span id="Roldisplaydate" class="form-control" style="display:none;"></span>
                                            <span id="Roldisplaydateymd" class="form-control" style="display:none;"></span>
                                            <span asp-validation-for="StartDate" class="invalid-feedback"></span>
                                        </div>
                                    </div>
                                    @*=====================         TEXT BOX                =================*@

                                    <div class="row mb-3" id="Rlenddate">
                                        <label class="control-label col-sm-4 col-form-label text-end required space" for="basic-default-name" asp-for="EndDate"></label>
                                        <div class="col-sm-4 form-group">
                                            <input type="date" class="form-control" id="EndDateid" asp-for="EndDate" required>
                                            <span asp-validation-for="EndDate" class="invalid-feedback"></span>
                                            <span class="compare"></span>
                                        </div>
                                    </div>

                                    @*=====================         TEXT BOX                =================*@

                                    <div class="row mb-3">

                                        <label class="control-label col-sm-4 col-form-label text-end required space" for="basic-default-name" asp-for="Departments"></label>
                                        <div class="col-sm-4">
                                            <div class="position-relative" id="dropdown">

                                                @Html.DropDownListFor(
                                           x => x.Departments,
                                            new SelectList(ViewBag.Department, "Value", "Text"),
                                           "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "Ddldepartment", @style = "color:black;", @required = "required" })
                                                <span asp-validation-for="Departments" class="invalid-feedback"></span>
                                            </div>
                                        </div>
                                        <label class="control-label col-sm-2 col-form-label text-end space">
                                            Total Credits
                                        </label>
                                        <label class="control-label col-sm-2 col-form-label text-danger">
                                            @ViewBag.TotalCredits
                                        </label>

                                    </div>

                                    @*=====================         TEXT BOX                =================*@

                                    <div class="row mb-3" id="Rlclass">
                                        <label class="control-label col-sm-4 col-form-label text-end required space" asp-for="SubclassificaitionId"></label>
                                        <div class="col-sm-4">
                                            <div class="position-relative">
                                                <select class="select2 form-select select2-hidden-accessible" data-val="true" id="DdlSubClass" name="SubclassificaitionId" required="required" style="color:black;" asp-for="SubclassificaitionId">
                                                </select>
                                                <span asp-validation-for="SubclassificaitionId" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <label class="control-label col-sm-2 col-form-label text-end space">
                                            Used Credits
                                        </label>
                                        <label class="control-label col-sm-2 col-form-label text-danger">
                                            @ViewBag.UsedCredits
                                        </label>
                                    </div>

                                    @*=====================         TEXT BOX                =================*@

                                    <div class="row mb-3">
                                        <label asp-for="InstancesubjectId" class="control-label col-sm-4 col-form-label text-end required space">Slot</label>
                                        <div class="col-sm-4">

                                            <div class="position-relative">
                                                <select class="select2 form-select select2-hidden-accessible" data-val="true" id="Ddslotsid" required="required" style="color:black;" asp-for="InstancesubjectId">
                                                </select>
                                                <span asp-validation-for="InstancesubjectId" class="text-danger"></span>
                                            </div>
                                        </div>

                                        <label class="control-label col-sm-2 col-form-label text-end space">
                                            Remaining Credits
                                        </label>
                                        <label class="control-label col-sm-2 col-form-label text-danger">
                                            @ViewBag.RemCredits
                                        </label>
                                    </div>

                                    @*=====================         TEXT BOX                =================*@

                                    <div class="row mb-3">
                                        <label class="control-label col-sm-4 col-form-label text-end"></label>
                                        <div class="col-sm-4">
                                            <input type="checkbox" class="form-check-input checkbox_animated" asp-for="ShowChangeActivity" id="Changactivitychk">
                                            <label class="form-check-label" id="Changactivitychk" asp-for="ShowChangeActivity">Show Change Activity</label>
                                        </div>
                                    </div>

                                    @*=====================         BUTTONS                =================*@

                                    <div class="row justify-content-end" id="deletebutton">
                                        <div class="col-sm-6 text-end" id="deleteinner">

                                        </div>
                                        <div class="col-sm-6">
                                            <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="sub_tblPA">Get Attendance Form</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </form>
                        @*=============================  Form End ================================*@
                    </div>
                </div>
               
                    <div id="GetStudentAttendenceAppend"></div>

                
            </div>
        </div>
    </div>
</body>
</html>
<script src="~/lib/jquery/dist/jquery.js" type="text/javascript"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
@*<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>*@


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/Postattendance.js"></script>
@*<script src="~/js/Mentor_Attendance.js"></script>*@