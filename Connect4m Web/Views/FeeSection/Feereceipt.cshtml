            null                                                                  // Response value return class name
        );
    }
    $('#searchForm').submit(function () {
        event.preventDefault();
        event.stopImmediatePropagation();
        debugger;
        setTimeout(function () {

            var validationMessages = $('.field-validation-error');
            var validationMessages2 = $('.error2');

            var validationMessagesLength = validationMessages.length;

            if (validationMessagesLength === 0 && validationMessages2.length === 0) {
                loaddingimg.css('display', 'block');
                /* debugger;*/
                //$('#Studentdetailsid').text('');
                //$('#Studentfeedetailsscheduledornotspanid').text('');




                var formData = $('#searchForm').serialize();
                handleAjax('POST', '/FeeSection/Feereceipt', formData,
                    function (response) {
                        debugger;

                        bindDatatable(response);
                        loaddingimg.css('display', 'none');

                    }, function (status, error) {
                        loaddingimg.css('display', 'none');
                    }, false);
            }
        }, 50);
    });
    function bindDatatable(response) {

        debugger;
        var table = $('#FeeRecipttable').DataTable();
        table.destroy();

        $("#TableCount").text(response.length);
        var newTable = $("#FeeRecipttable").DataTable({
            dom: '<"tops"lf>t<"bottom"ip>',
            buttons: [],
            bProcessing: false,
            bLengthChange: false,
            /*  lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "ALL"]],*/
            bfilter: true,
            bSort: false,
            searching: false,
            //scrollX: true,
            //scrollY: '400px',
            /* scrollCollapse: true,*/
            paging: true,
            bPaginate: false,
            //  stateSave:true,
            data: response,
            columns: [
                {
                    data: "Studentuserid",
                    render: function (data, type, row, meta) {
                        return `<input type="checkbox" value="${row.studentuserid}" id="checkbox_${row.studentuserid}" name="selectedUserIds[]" class="user-checkbox form-check-input" />`;
                    }
                },
                {
                    data: "FirstName",
                    render: function (data, type, row, meta) {
                        return row.firstName;
                    }
                },
                {
                    data: "ClassificationName",
                    render: function (data, type, row, meta) {
                        return row.classificationName;
                    }
                },
                {
                    data: "SubClassificationName",
                    render: function (data, type, row, meta) {
                        return row.subClassificationName;
                    }
                }
            ],
            drawCallback: function () {
                // Ensure the button is only added once
                if ($('#myButton').length === 0) {
                    $('<button/>', {
                        text: 'Go to Step 2', // Button text
                        id: 'myButton', // Button ID
                        class: 'go-to-step2-button btn btn-success btn-pill btn-outline-primary-2x btn-sm', // Button classes (Bootstrap example)
                        //click: function () { // Button click event handler
                        //    alert('Button clicked!');
                        //}
                        click: handleButtonClick
                    }).appendTo('#button-container'); // Append button to the container
                }
            }
        });
        $('#Searchresiltstbl_Divid1').show();
        loaddingimg.css('display', 'none');
    }
    function SearchClearform(formId) {
        var form = document.getElementById(formId);
        if (form) {
            form.reset(); // Reset the form elements
            var validationSpans = form.querySelectorAll('span[data-valmsg-for]');
            validationSpans.forEach(span => {
                span.textContent = ''; 
            });
            $('#Commonerrormessage').text('');
            $('#Errormessage_1').text('');
            $('#Errormessage_3').text('');
            $('#Errormessage_4').text('');
            $('#Errormessage_5').text('');
            $('#Searchresiltstbl_Divid1').hide();
            $('#Feetermsdetails_Divid2').hide();
            $('#Challanauserdetails_Divid3').hide();
            $('.form-check-input').prop('checked', false);
        }
    }

    // Check/uncheck all checkboxes with the class "user-checkbox"
    function checkAllCheckboxes(checked) {
        debugger;
        // Get DataTable instance
        var table = $('#FeeRecipttable').DataTable();

        // Iterate over all rows in the DataTable
        table.rows().every(function () {
            var row = this.node();
            $(row).find('.user-checkbox').prop('checked', checked);
        });

        //OLD CODE
        //$('.user-checkbox').prop('checked', checked);
    }

    // Click event for the "Check All" checkbox
    $('#Checkalluserids').click(function () {
        debugger;
        var checked = $(this).prop('checked');
        checkAllCheckboxes(checked);
    });

    // Click event for the "Go to Step 2" button
    function handleButtonClick() {
        var selectedUserIds = $('.user-checkbox:checked').map(function () {
            return $(this).val();
        }).get();

        if (selectedUserIds.length === 0) {
            $('#Errormessage_1').text('Please select atleast one student to generate challan for fee.');
            window.scroll(0, 0);
            $('#Feetermsdetails_Divid2, #Challanauserdetails_Divid3').hide();
            return;
        }

        $('#Errormessage_1').text('');

        // Fetch dropdown data
        fetchDataAndPopulateDropdown('/FeeSection/FrTermsddl', '#Feetermddl');
        fetchDataAndPopulateDropdown('/FeeSection/Frfeetypeddl', '#Feetypeddl');

        $('#Errormessage_3').text('');

        // Call AJAX function
        chalanGenerate(selectedUserIds);
    }

