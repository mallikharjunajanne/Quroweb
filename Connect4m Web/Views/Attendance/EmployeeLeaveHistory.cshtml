    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Employee Leave History";
    //Layout = null;
}

<!DOCTYPE html>
<html>
<head></head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <div class="row mb-2">
            <div class="col-md-12 col-lg-12 mb-3">
                <div class="tab-content" id="myTabContent">
                    <div class="row">
                        <div class="row mb-2">
                            <label class="col-sm-6 col-form-label space text-end" for="basic-default-name">Employee Name </label>
                            <div class="col-sm-6">
                                <label class="col-sm-6 col-form-label" for="basic-default-name">@ViewBag.FirstName </label>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-sm-6 col-form-label space text-end" for="basic-default-name">Department Name</label>
                            <div class="form-group col-sm-6">
                                <label class="col-sm-6 col-form-label" for="basic-default-name">@ViewBag.ClassificationName </label>
                            </div>
                        </div>
                    </div>
                    <div class="card" id="FmAppliedStaffLeaves_SearchRecords_Div" style="">
                        <div class="card-header bg-danger text-white">
                            <span class="text-header">
                                TOTOAL NUMBER OF RECORDS :
                                <span id="Counts" class="badge badge-center rounded-pill bg-primary bg-glow text-header"> @ViewBag.listvalues.Count </span>
                            </span>
                        </div>
                        <table class="table table-hover table-bordered no-footer dataTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Sl. No</th>
                                    <th>From Date</th>
                                    <th>To Date</th>
                                    <th>Reason</th>
                                    <th>No.of Days</th>
                                    <th>Status</th>
                                    <th>Comments</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int Index = 1;
                                }
                                @foreach (var item in ViewBag.listvalues)
                                {
                                    <tr>
                                        <td>@Index</td>
                                        <td>@item.FromdateString</td>
                                        <td>@item.TodateString</td>
                                        <td>@item.Reason</td>
                                        <td>@item.LeaveNoOfDays</td>
                                        <td>@item.LeaveStatus</td>
                                        <td>@item.Comments</td>
                                    </tr>
                                    Index++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>