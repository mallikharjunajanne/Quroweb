@model Connect4m_Web.Models.Attendenceproperites.UserScreen.SMSTemplates
@{
    ViewData["Title"] = "Create sms";
    Layout = null;
}
<style>
    .scrollable-table-container {
        height: 250px;
        width: 100%;
        overflow: scroll;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 10px;
            text-align: left;
        }

        .table th {
            background-color: #f2f2f2;
            font-weight: bold;
        }

    .form-check-input {
        margin: 0;
    }

    .input-style {
        width: 18%;
        height: 23px;
        padding: 0.3rem 0.5rem;
        font-size: 0.7rem;
        font-weight: 400;
        line-height: 1.6;
        color: #6f6b7d;
        appearance: none;
        background-color: #fff;
        background-clip: padding-box;
        border: var(--bs-border-width) solid #dbdade;
        border-radius: var(--bs-border-radius);
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
</style>

<div class="col-md-12 col-lg-12 mb-3" id="manage-notice-create-sms-container">
    <span id="validationErrorMessage2" class="Validation text-danger"></span>
    <div class="card mb-4">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between"><span class="text-header">SAVE SMS</span></div>
        <div class="card-body mb-1">
            <div class="row">
                <div class="col-2">
                    <label class="control-label col-sm-10 col-form-label text-end space">SMS Template</label>
                </div>
                <div class="col-10">
                    <div class="scrollable-table-container">
                        <table class="table-responsive">
                            <tbody>
                                @foreach (var item in ViewBag.SMSTemplates)
                                {
                                    <tr>
                                        <td>
                                            <input type="radio"
                                                   value="@item.TemplateMasterPK"
                                                   name="Templatedetails"
                                                   class="form-check-input check"
                                                   id="template-@item.TemplateMasterPK" />
                                        </td>
                                        <td>
                                            @item.TemplateDescription
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-2"></div>
                <div class="col-10">
                    <span style="font: 12px arial; color: blue;">
                        <b>NOTE:</b>   Following characters are restricted:<b>< > & | % "</b>
                        Some Characters like <b>` ~ ^ + $</b> may not deliver properly to all mobiles.
                        <b> <br />Date format can be: dd/mm/yy or dd/mm/yyyy</b>
                    </span>
                </div>
                <div class="justify-content text-center">
                    <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="SMSNextbtn">Edit SMS Template</button>
                    <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="SMSBacktosearchbtn">Back To Search</button>
                </div>
            </div>
        </div>


        @*<input type="hidden" id="lblSMSTemplateOriginalValue" />*@
        <div class="col-sm-12 row mb-2">
            <span id="lblSMSTemplateOriginalValue"></span>
            <input type="hidden" id="lbltemplateMasterPK" />
            <span id="lbltemplateMasterPK" style="display:block;"></span>
        </div>
        <div class="col-sm-12 row mb-2">
            <div id="append-sms-templates-section"></div>
        </div>

        <div id="hiddendatediv" style="display:none;">
            <div class="row mb-2">
                <label class="control-label col-sm-4 col-form-label text-end required space">Start Date</label>
                <div class="col-sm-4">
                    <input type="date" asp-for="Startdate" id="Startdatetxtid" class="form-control" />
                    <span asp-validation-for="Startdate" class="text-danger Validation"></span>
                </div>
            </div>
            <div class="row mb-2">
                <label class="control-label col-sm-4 col-form-label text-end required space">End Date(Expiry Date)</label>
                <div class="col-sm-4">
                    <input type="date" asp-for="Expirydate" id="Exdatetxtid" class="form-control" />
                    <span asp-validation-for="Expirydate" class="text-danger Validation"></span>
                    <span id="DateCompareErrormessage" class="text-danger"></span>
                </div>
            </div>
            <div class="col-sm-12 text-center">
                <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="btnBackToSelectSMSTemplates">Back To Select SMS Template(s)</button>
                <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="btnSaveAndPostSMSTemplate">Save and Post</button>
            </div>
        </div>

    </div>
</div>

<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script src="~/js/_Managenotice2.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
