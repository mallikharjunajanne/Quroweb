@model Connect4m_Web.Models.Attendenceproperites.Feeconcedingtypes

@{
    ViewData["Title"] = "Feeconcedingtypes";
    Layout = null;

}

<div class="col-md-12 col-lg-12 mb-3">
    <div class="card mb-4">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
            UPDATE FEE DISCOUNT TYPE
            <small class="text-header-small">* INDICATES MANDATORY FIELD</small>
        </div>
        <div class="card-body">
            <form class="form" id="Updatediscountfeetypeform">
                <div class="row mb-2">
                    <label asp-for="ConcedingTypeName" class="control-label col-sm-4 col-form-label text-end required space">Fee Discount Type </label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="ConcedingTypeName" id="EdittxtConcedingTypeNameid" class="form-control">
                        <span asp-validation-for="ConcedingTypeName" class="text-danger"></span>
                        <input type="hidden" asp-for="ConcedingTypeId" id="EdittxtConcedingTypeid" />
                    </div>
                </div>
                <div class="row mb-2">
                    <label asp-for="Amount" class="control-label col-sm-4 col-form-label text-end required space">Amount </label>
                    <div class="col-sm-4">
                        <input type="text" asp-for="Amount" id="Edittxtamountid" class="form-control">
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label asp-for="Description" class="control-label col-sm-4 col-form-label text-end  space">Description </label>
                    <div class="col-sm-4">
                        <textarea asp-for="Description" id="Edittxtdescriptionid" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="justify-content text-center">
                    <button type="button" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Confirmdltall('','');" id="Btndelete">Delete</button>
                    <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="updbacktosearchbtn">Back To Search</button>
                    <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Btnupdate">Update</button>
                    <button type="button" class="btn btn-primary waves-effect waves-light btn-sm" onclick="nextpages('ManageFeeTypes',null)">Next Page</button>
                </div>
            </form>
        </div>
    </div>
</div>





<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>

<script src="~/js/ManageFeeConcedingtypes1.js"></script>
