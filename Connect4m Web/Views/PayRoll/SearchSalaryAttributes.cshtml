@model Connect4m_Web.Models.LMSproperties.PayRollproperties
@{
    ViewData["Title"] = "Configure Salary components";
    Layout = null;
}
<html>
<head>
    <title>@ViewData["Title"]</title>
    @*<link href="~/Datatable/jquery.dataTables.css" rel="stylesheet" />*@
    @*<link href="~/css/CommonStyle.css" rel="stylesheet" />*@
    <style>
        #appendforinsertsalaryattribute {
            display: none;
        }
    </style>
</head>
<body>
    <h4 class="mb-4 text-center text-header">CONFIGURE SALARY ATTRIBUTE</h4>
    <div class="col-md-12 col-lg-12 mb-3">
        @*<span id="AddNewText_Span_CreatePage">CONFIGURE SALARY ATTRIBUTES</span>*@
        <div class="demo-inline-spacing text-end">
            @*<div class="col-sm-3">
                </div>*@
            <button type="button" class="btn rounded-pill btn-info waves-effect waves-light btn-sm" id="addnewsalaryattributebtn">
                Create Instance Salary Attributes
            </button>
        </div>
        <div id="appendsearchsalaryattribute">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    @*<h5><label>SEARCH SALARY ATTRIBUTES</label></h5>*@
                    <span class="text-header"> SEARCH SALARY ATTRIBUTES </span>
                </div>
                <div class="card-body mb-2">

                    @*=============================  Form Start ================================*@
                    <form id="Serach_CSA">
                        <div>
                            <div class="row">
                                <div class="col">

                                    @*=====================        Drop Down                =================*@

                                    <div class="row mb-3">

                                        <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="SalaryAttributeMasterId"></label>
                                        <div class="col-sm-4">
                                            <div class="position-relative" id="Drop_Format_SEM_3">

                                                @Html.DropDownListFor(
                                           x => x.SalaryAttributeMasterId,
                                            new SelectList(ViewBag.SalaryAttributeMasterId, "Value", "Text"),
                                           "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_SalaryAttributeMasterId_CSA", @style = "color:black;" })
                                            </div>
                                        </div>
                                        <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="SalaryAttributeName"></label>
                                        <div class="col-sm-4 form-group">
                                            <input class="form-control" asp-for="SalaryAttributeName">

                                        </div>
                                    </div>

                                    @*=====================        TEXT BOX                 =================*@

                                    <div class="row mb-3">
                                        <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="SalaryAttributeType"></label>
                                        <div class="col-sm-4">
                                            <div class="position-relative" id="Drop_Format_SEM_3">

                                                @Html.DropDownListFor(
                                           x => x.SalaryAttributeType,
                                            new SelectList(ViewBag.SalaryAttributeType, "Value", "Text"),
                                           "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_SalaryAttributeType_CSAsearch", @style = "color:black;" })
                                            </div>
                                        </div>

                                        <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="IsActive"></label>
                                        <div class="col-sm-4">
                                            <div class="position-relative" id="Drop_Format_SEM_2">

                                                @Html.DropDownListFor(
                                           x => x.IsActive,
                                            new SelectList(ViewBag.IsActive, "Value", "Text"),
                                           "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_IsActive_CSA", @style = "color:black;" })
                                            </div>
                                        </div>
                                    </div>

                                    @*=====================        TEXT BOX                 =================*@

                                    <div class="row mb-3">
                                        <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="StartDate"></label>
                                        <div class="col-sm-4">
                                            <input type="date" class="form-control" id="StartDate" asp-for="StartDate">
                                        </div>
                                        <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="EndDate"></label>
                                        <div class="col-sm-4">
                                            <input type="date" class="form-control" id="StartDate" asp-for="EndDate">
                                        </div>
                                    </div>

                                    @*=====================         BUTTONS                =================*@

                                    <div class="justify-content text-center">
                                        <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="clearform" onclick="clearfun('Serach_CSA')">Clear</button>
                                        <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="sub_tblCSA">Search</button>

                                        <button type="button" class="btn btn-primary waves-effect waves-light btn-sm" id="Nextpage_CSA" onclick="nextpage('SearchSalaryAttributesForRoles',null)">Next Page</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    @*=============================  Form End ================================*@

                </div>
            </div>


            @*=============================  TABLE START ================================*@
            <div class="card">
                <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
                    @*<h6 class="mb-0">*@
                    <span id="AddNewText_Span_CreatePage" class="text-header">
                        MANAGE INSTANCE SALARY ATTRIBUTES
                    </span>
                    @*</h6>*@
                </div>
                <div class="card-header bg-danger text-white">
                    @*<h6 class="card-title mb-0">*@
                    <span class="text-header">YOUR SEARCH RESULTED <span id="totalrecords_Tranctions_CSA" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span> RECORD(S).</span>
                    @*</h6>*@
                </div>
                <div class="table-responsive text-nowrap">
                    <table id="tblCSAsearchresults" class="link table table-hover table-bordered ">
                        <thead class="table-dark">

                            <tr>
                                <th>
                                    S.No
                                </th>
                                <th>
                                    S.No
                                </th>
                                <th>
                                    Attribute Name
                                </th>
                                <th>
                                    Type

                                </th>
                                <th>
                                    StartDate

                                </th>
                                <th>
                                    EndDate

                                </th>
                                <th>
                                    IsActive

                                </th>
                                <th>
                                    Delete

                                </th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            @*=============================  TABLE END ================================*@
        </div>
        <div id="appendforinsertsalaryattribute">

        </div>       
    </div>
</body>
</html>





@*<script src="~/Datatable/jquery.dataTables.js"></script>
    <script src="~/Datatable/jquery.dataTables.min.js"></script>*@
@*<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>*@

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
