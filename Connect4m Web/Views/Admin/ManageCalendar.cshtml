@model Connect4m_Web.Models.Attendenceproperites.UserScreen.EventsClander
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <style>
    .MonthYearHeader {
        background-color: Silver;
        border-style: Solid;
        height: 12pt;
        font-size: 18px;
    }

    .Week {
        color: #333333;
        font-size: 11pt;
        font-weight: bold;
        height: 8pt;
    }

    .Weekdays {
        border-width: 2px;
    }

    .BlurredDay {
        filter: blur(3px); /* Apply a blur effect */
        color: transparent; /* Hide text content */
        pointer-events: none; /* Disable pointer events on blurred cells */
    }

    .CurrentMonth {
        color: blue; /* Change color for the selected month's dates */
    }

    .OtherMonth {
        color: gray; /* Change color for the dates of the previous and next months */
    }
</style>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-1 text-center">MANAGE CALENDAR </h4>
        <div class="row mb-2">
            <div class="row justify-content" id="Manageholidays_Heaingmaindiv0">
                <div class="col-sm-12 text-end">
                    <button class="btn btn-label-linkedin waves-effect btn-sm" id="Addnewevent"> Create Event</button>
                </div>
            </div>
            <span id="Errormessage" class="text-validation"></span>
            <div id="Managecalendarmaindiv">
                <div class="col-md-12 col-lg-12 mb-3">
                    <div class="card mb-4">
                        <div class="card-header bg-danger text-white text-header">
                            SEARCH EVENTS
                        </div>
                        <div class="card-body">
                            <div class="row col" id="Managecalendardiv1">
                                <form id="Searchingform">
                                    <div class="row mb-3">
                                        <label class="control-label col-sm-4 col-form-label text-end space">Month</label>
                                        <div class="col-sm-4">
                                            <select class="select2 form-select select2-hidden-accessible" asp-for="MonthId" id="Eventmonthddl">
                                            </select>
                                        </div>
                                        <div class="col-sm-4">
                                            <a href="javascript:void(0)" id="Calendarpriviewid" class="btn btn-label-linkedin waves-effect btn-sm">Preview</a>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="control-label col-sm-4 col-form-label text-end space">Title</label>
                                        <div class="col-sm-4">
                                            <input type="text" class="form-control" asp-for="EventTitle" name="Eventtittle" id="txteventtitleid" />
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="control-label col-sm-4 col-form-label text-end space">Event Date</label>
                                        <div class="col-sm-4">
                                            <input type="date" class="form-control" asp-for="eventdate" name="txteventdate" id="txteventdateid" />
                                        </div>
                                    </div>
                                    <div class="col-sm-12 text-center">
                                        <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Clearcommonfunction('Searchingform', null)" id="Clearbtnquote">Clear</button>
                                        <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="Searchbtn">Search</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div id="Managecalendardiv2">
                        <span id="Errmsg" class="text-validation"></span>
                        <div class="col-md-12 col-lg-12 mb-3">
                            <div class="card mb-4">
                                <div class="card-header bg-danger text-white text-header">
                                    YOUR SEARCH RESULTED
                                    <span id="calendartblcount" class="badge badge-center rounded-pill bg-primary bg-glow text-header">
                                        0
                                    </span>
                                    RECORDS.
                                </div>
                                <table class="table table-bordered" id="Managecalendartbl">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 55%;">Title</th>
                                            <th align="center">Event Date</th>
                                            <th align="center">Delete</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="InsertManagecalendardiv2"></div>
            <div id="UpdateManagecalendardiv3"></div>

            <div id="previewofcalendardiv4"  style="display:none;">
                <div class="text-right">
                    <a hreh="javascript:void(0);" id="Priviewbacktosearchbtn" class="btn btn-label-linkedin waves-effect btn-sm">Back</a>|
                    <a href="javascript:void(0);" id="btnprieviewcalendarprint" class="btn btn-label-linkedin waves-effect btn-sm">Print</a>
                </div>
                <div id="Previewofcalendardiv5"></div>
            </div>
        </div>
    </div>
</body>
</html>


<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="~/js/Managecalendar.js"></script>









