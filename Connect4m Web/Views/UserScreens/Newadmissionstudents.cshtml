@model Connect4m_Web.Models.Attendenceproperites.UserScreen.Timetablecriteria
@{
    ViewData["Title"] = "Newadmissionstudents";
    Layout = null;
}

<style>
    .Htbl {
        width: 100%;
        border-collapse: separate;
        border: 1px solid #afd4f7;
    }

    .Htbltr {
        background-color: #E8E8E8;
        font-size: 14px;
        font-weight: 700;
        height: 26px;
        text-align: center;
        color: black;
    }

    .Htbltrtd {
        border: 1px solid #dbdbdb;
        height: 24px;
        color: black
    }
</style>
@if (ViewBag.Newstudentadmissions.Count > 0)
{
    <table class="Htbl">
        <tr class="Htbltr">
            <th>StudentName</th>
            <th>Department</th>
            <th>Class</th>
            <th>DateofJoining</th>
        </tr>

        <tbody>
            @foreach (var item in ViewBag.Newstudentadmissions)
            {
                <tr>
                    <td class="Htbltrtd">@item.FirstName</td>
                    <td class="Htbltrtd">@item.ClassificationName</td>
                    <td class="Htbltrtd">@item.SubclassificationName</td>
                    <td class="Htbltrtd">@item.DateofJoining</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <span class="text-dark">No data available in this new admission.</span>
}


