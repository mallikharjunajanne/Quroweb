@model IEnumerable<Connect4m_Web.Models.Attendenceproperites.Userwisepayment>

@{
    Layout = null;
}

<style>
    .header {
        display: flex;
        align-items: center;
        margin-bottom: 25px;
        font-family: 'Akkurat mono';
    }

    .logo {
        float: left;
        margin-right: 20px;
        font-family: 'Akkurat mono';
    }

    .school-info {
        text-align: left;
        font-family: 'Akkurat mono';
    }

    .details {
        margin-bottom: 20px;
        font-family: 'Akkurat mono';
    }

    .Challanrow {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .info-item {
        flex-basis: 30%;
        font-family: 'Akkurat mono';
    }

    .infos-items {
        flex-basis: auto;
        font-family: 'Akkurat mono';
    }
    .label {
        font-weight: bold;
        font-family: 'Akkurat mono';
    }

    .footer {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
        font-family: 'Akkurat mono';
    }

    .stamp, .signature {
        text-align: center;
        padding: 60px 10px 0px 0px;
    }
</style>


<span class="text-danger" id="Errormessagespid"></span>
<br />
<button type="button" class="btn btn-label-linkedin waves-effect btn-sm" id="PaymentdetailsBacktosearchbtn">Back To Search</button>
<br />
<span class="text-dark" id="Challanid" value="@ViewBag.ChallanId">Selected Student : @ViewBag.username</span>
<input type="hidden" id="Userreceiptgenerationidtxtid" value="@ViewBag.Userreceiptgenerationid" />
<input type="hidden" id="FeeUseridtxt" value="@ViewBag.FUserid" />
<div class="card mb-3">
    <div class="card-header bg-danger text-white">PAYMENT DETAILS</div>
    <div class="card-datatable text-nowrap">
        <div class="table-responsive text-nowrap">
            <table class="table table-bordered" id="Installmentfeedetailstblid">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Particulars</th>
                        <th></th>
                        <th></th>
                        <th>Balance</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Createdate</td>
                            <td>
                                <a href="javascript:void(0)" style="text-decoration:underline;" data-id="@item.modename" onclick="FeestatementDetailsbyuserid('@item.UserReceiptGenerationID','@item.balance','@item.Createdate')">
                                    @item.modename
                                </a>
                            </td>
                            <td>@item.typename</td>
                            <td>@item.Amount</td>
                            <td>
                                @item.balance
                                <span value="@item.UserId" title="@item.Createdate" name="@ViewBag.username"></span>
                            </td>
                            <td align="center">  <a href=""><i class="ti ti-trash text-danger" data-invoice="@item.InvoiceNo"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="Paymentoptionchangediv">
        <div class="card-body">
            <form id="Feechallanreport_formPay" enctype="multipart/form-data">
                <div class="row mb-2">
                    <label class="col-sm-2 col-form-label text-end  space" for="basic-default-name">Challan Number</label>
                    <div class="col-sm-4">
                        <span id="ChallanaIdsptxtid"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-sm-2 col-form-label text-end required space" for="basic-default-name">Amount</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="Amounttxt">
                        <span class="text-danger" id="Amounttxtspanid"></span>
                    </div>
                    <label class="col-sm-2 col-form-label text-end required space" for="basic-default-name">Payment Date</label>
                    <div class="col-sm-4">
                        <input type="date" class="form-control" id="Paymentdatetxt">
                        <span class="text-danger" id="Paymentdatetxtspanid"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-sm-2 col-form-label text-end space" for="basic-default-name">Particulars </label>
                    <div class="col-sm-4">
                        <div class="position-relative">
                            <select class="select2 form-select select2-hidden-accessible" id="PaymentModedd">
                            </select>
                        </div>
                    </div>
                    <label class="col-sm-2 col-form-label text-end space" for="basic-default-name">Cheque/DD No</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="Chequeddnotxt">
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-sm-2 col-form-label text-end space" for="basic-default-name">Fine  </label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="finetxt">
                    </div>
                    <label class="col-sm-2 col-form-label text-end space" for="basic-default-name">Transaction Id </label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="Transactiontxt">
                    </div>
                </div>
                <div class="text-center">
                    <button type="reset" class="btn btn-danger waves-effect waves-light" id="BtnClear" onclik="btnclearpay('Feechallanreport_formPay')">Clear</button>
                    <button type="button" class="btn btn-success waves-effect waves-light" id="Submitbtn">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>



<div class="col-md-12 col-lg-12 mb-3" id="PrintchallanaUserwisefeepaymentdivid" style="display:none;">
    <div class="text-end">
        <button class="btn btn-label-linkedin waves-effect btn-sm">Print</button>
    </div>
    <div class="card mb-3">
        <div class="card-header bg-danger text-white"> Fee Receipt </div>
        <div class="card-body">
            <div class="container">
                <!-- Header Section -->
                <div class="header">
                    <div class="logo">
                        <img src="~/assets/img/QuroSchool_Logo.png" alt="School Logo" height="100" width="100" />
                    </div>
                    <div class="school-info">
                        <div class="school-name">
                            QURO SCHOOL
                        </div>
                        <div class="school-address">
                            Raghav Nagar, Hyderabad, Telangana - 500003
                        </div>
                    </div>
                </div>

                <!-- Details Section -->
                <div class="details">
                    <div class="Challanrow">
                        <div class="info-item">
                            <span class="label">Receipt Number :</span> <span id="Receiptnumberspid" class="value"> </span>
                        </div>
                        <div class="info-item">
                            <span class="label">Name :</span> <span id="Namespid" class="value"> </span>
                        </div>
                        <div class="info-item">
                            <span class="label">Class :</span> <span id="Classspid" class="value"> </span>
                        </div>
                    </div>
                    <div class="Challanrow">
                        <div class="infos-items">
                            Received Rupees <span id="Amountspanid" class="value">-29850.00</span> on <span id="Paymentdatespid" class="value">04/07/2024</span> towards fees.
                        </div>
                    </div>
                </div>

                <!-- Footer Section -->
                <div class="footer">
                    <div class="stamp">
                        <span>Stamp</span>
                    </div>
                    <div class="signature">
                        <span>Signature Of Accountant</span>
                    </div>
                    <div class="signature">
                        <span>Signature Of Payee</span>
                    </div>
                </div>
            </div>
            <hr />
            <div class="container">
                <!-- Header Section -->
                <div class="header">
                    <div class="logo">
                        <img src="~/assets/img/QuroSchool_Logo.png" alt="School Logo" height="100" width="100" />
                    </div>
                    <div class="school-info">
                        <div class="school-name">
                            QURO SCHOOL
                        </div>
                        <div class="school-address">
                            Raghav Nagar, Hyderabad, Telangana - 500003
                        </div>
                    </div>
                </div>

                <!-- Details Section -->
                <div class="details">
                    <div class="Challanrow">
                        <div class="info-item">
                            <span class="label">Receipt Number :</span> <span id="Receiptnumberspid" class="value"> </span>
                        </div>
                        <div class="info-item">
                            <span class="label">Name :</span> <span id="Namespid" class="value"> </span>
                        </div>
                        <div class="info-item">
                            <span class="label">Class :</span> <span id="Classspid" class="value"> </span>
                        </div>
                    </div>
                    <div class="Challanrow">
                        <div class="infos-items">
                            Received Rupees <span id="Amountspanid" class="value">-29850.00</span> on <span id="Paymentdatespid" class="value">04/07/2024</span> towards fees.
                        </div>
                    </div>
                </div>

                <!-- Footer Section -->
                <div class="footer">
                    <div class="stamp">
                        <span>Stamp</span>
                    </div>
                    <div class="signature">
                        <span>Signature Of Accountant</span>
                    </div>
                    <div class="signature">
                        <span>Signature Of Payee</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<script src="~/js/Userwisepayment.js"></script>


