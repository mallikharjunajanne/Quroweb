
@model Connect4m_Web.Models.Attendenceproperites.UserScreen.studentwithdrawal
@{
    ViewData["Title"] = "Studentsunderwithdrawal";
    Layout = null;
}


<style>
    .Hstbl {
        width: 100%;
        border-collapse: separate;
        border: 1px solid #afd4f7;
    }

    .Hstbltr {
        background-color: #E8E8E8;
        font-size: 14px;
        font-weight: 700;
        height: 26px;
        text-align: center;
        color: black;
    }

    .Hstbltrtd {
        border: 1px solid #dbdbdb;
        height: 24px;
        color: black
    }
</style>

@if (ViewBag.Withdrawal.Count > 0)
{
<table class="Hstbl">
    <thead>
        <tr class="Hstbltr">
            <th>Studentname</th>
            <th>Student withdrawal Id</th>
            <th>TC Issue Date</th>
            <th>Department</th>
            <th>Class</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.Withdrawal)
        {
            <tr>
                <td class="Hstbltrtd">@item.FirstName</td>
                <td class="Hstbltrtd">@item.StudentWithdrawalID</td>
                <td class="Hstbltrtd">@item.TCIssueDate</td>
                <td class="Hstbltrtd">@item.ClassificationName</td>
                <td class="Hstbltrtd">@item.SubclassificationName</td>
            </tr>
        }
    </tbody>
</table>
}
else
{
<span class="text-dark">No data available in this area.</span>
}
