@model Connect4m_Web.Models.Attendenceproperites.Feetypes
@{
    ViewData["Tittle"] = "Manage Fee Types";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Tittle"]</title>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-3 text-center text-header">MANAGE FEE TYPES</h4>
        <span id="Commonerrormessage" class="text-validation"></span>
        <div class="row mb-2">
            <div class="text-end">
                <button id="Addnewfeetypelinkbtn" class="btn btn-label-linkedin waves-effect btn-sm" onclick="lnkAddNewfeetype(event)">
                    Create Fee Type
                </button>
            </div>
            <div id="SearchFeetype_tbldiv">
                <div class="col-md-12 col-lg-12 mb-3">
                    <div class="card mb-4">
                        <div class="card-header bg-danger text-white text-header">FEE TYPES</div>
                        <div class="card-body">
                            <form id="Feetypesform" enctype="multipart/form-data">
                                <div class="row">
                                    <div class="row mb-3">
                                        <div class="row mb-3">
                                            <label class="col-sm-4 col-form-label space text-end" for="basic-default-name">Fee Type</label>
                                            <div class="col-sm-4">
                                                <input type="text" asp-for="FeeType" class="form-control" id="txtFeeTypesSeach" name="FeeType">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="justify-content-center text-center">
                                        <button type="button" class="btn btn-info waves-effect waves-light btn-sm" onclick="previouspages('ManageFeeConcedingTypes',null)">Previous Page</button>
                                        <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="SearchClearform()" id="BtnClear">Clear</button>
                                        <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="btnsearch">Search</button>
                                        <button type="button" class="btn btn-primary waves-effect waves-light btn-sm" onclick="nextpages('ManageFeeTerms',null)">Next Page</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 col-lg-12 mb-3">
                    <div class="card">
                        <div class="card-header bg-danger text-white text-header">
                            YOUR SEARCH RESULTED
                            <span id="Recordscount" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span>
                            RECORDS.
                        </div>
                        <div class="table-responsive text-nowrap" id="Admissiontbldiv">
                            <table id="Feetypestbl" class="table table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th>S. No.</th>
                                        <th>Fee Type</th>
                                        <th>Discount Type</th>
                                        <th>Description</th>
                                        <th>Delete</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="Addnewfeetype_div1">

        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>
<script src="~/js/Managefeetypes.js"></script>


















