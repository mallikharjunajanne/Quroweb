@model Connect4m_Web.Models.Attendenceproperites.Feechallanareport
@{
    ViewData["Title"] = "FeeReceiptNew";
    Layout = "~/Views/Shared/_Layout.cshtml";

    @*@model Connect4m_Web.Models.Attendenceproperites.FeeReports*@
}
<!DOCTYPE html>
<html>
<head>


</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        @*<h4 class="py-3 mb-4"><span class="text-muted fw-light">Reports /</span> Fee Challan Report</h4>*@
        <h4 class="mb-4 text-center text-header">Fee Challan Report</h4>
        <!-- Examples -->
        <div class="row mb-2">
            <div class="col-md-12 col-lg-12 mb-3">
                <span class="ErrorMessageSpan text-validation" id="Main_Span_Error"></span>
           
                <div class="card mb-4" id="SearchPage">
                    <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
                        <span id="AddNewText_Span_CreatePage" class="text-header">
                            SEARCH USERS
                        </span>
                        <small class="text-header-small">* INDICATES MANDATORY FIELD</small>
                    </div>
                    <div class="card-body" id="CreateNewSubjectsDiv">
                        <form id="Feechallanreport_form" enctype="multipart/form-data">
                            <div id="Searchingform">
                                <div class="row">
                                    <div class="row mb-3">
                                        <label class="col-sm-4 col-form-label text-end required space" for="basic-default-name">Class</label>
                                        <div class="col-sm-4">
                                            <div class="position-relative">
                                                <select class="select2 form-select select2-hidden-accessible" id="FddlDepartment" asp-for="SubClassificationId">
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="col-sm-4 col-form-label text-end space" for="basic-default-name">First Name</label>
                                        <div class="col-sm-4">
                                            <input type="text" class="form-control" id="Firstnametxtid" placeholder="First Name" asp-for="FirstName">
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="col-sm-4 col-form-label text-end  space" for="basic-default-name">Last Name</label>
                                        <div class="col-sm-4">
                                            <input type="text" class="form-control" id="Lastnametxtid" placeholder="Last Name" asp-for="LastName">
                                        </div>
                                    </div>

                                    <div class="justify-center text-center">
                                        <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="searchclearfun('Searchingform')" id="BtnClear">Clear</button>
                                        <button type="button" class="btn btn-success waves-effect waves-light btn-sm" onclick="Tabledata_Callingfun();" id="Btnsearch">Search</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header bg-danger text-white text-header">
                        <span class="text-header">
                            YOUR SEARCH RESULTED
                            <span id="tablecountlblid" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span>
                            RECORDS.
                        </span>
                    </div>
                    <div class="card-datatable text-nowrap">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered no-footer dataTable" id="Frtableid">
                                <thead class="table-dark">
                                    <tr>
                                        <th>SNO</th>
                                        <th>Select</th>
                                        <th>Name</th>
                                        <th>Department</th>
                                        <th>Class</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>


<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/Feechallanreport.js"></script>