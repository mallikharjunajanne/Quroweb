@model Connect4m_Web.Models.Attendenceproperites.Feeterms
@{
    ViewData["Title"] = "ManageFeeTerms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-1 text-center">MANAGE FEE TERMS</h4>
        <span id="Commonerrormessage" class="text-danger"></span>
        <div class="justify-content text-end">
            <button class="btn btn-label-linkedin waves-effect btn-sm" onclick="lnkAddNew(event)">Create Fee Terms</button>
            @*<a href="javascript:void(0);" id="Addnewfeetypelinkbtn">Create Fee Terms</a>*@
        </div>
        <div class="row mb-2" id="SearchFeeterm_tbldiv">
            <div class="col-md-12 col-lg-12 mb-3">
                <div class="card mb-4">
                    <div class="card-header bg-danger text-header text-white">SEARCH FEE TERMS</div>
                    <div class="card-body">
                                <form class="form" id="Searchfeetermform">
                                    <div class="row mb-2">
                                        <label class="control-label col-sm-4 col-form-label text-end space">Academic Year </label>
                                        <div class="col-sm-4">
                                            <select asp-for="AcademicYearId" class="form-select" id="ddlAcademicYearSearch">
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <label class="control-label col-sm-4 col-form-label text-end  space">Fee Term </label>
                                        <div class="col-sm-4">
                                            <input type="text" asp-for="TermName" class="form-control" id="txtFeeterm" name="TermName">
                                        </div>
                                    </div>
                                    <div class="text-center">
                                        <button type="button" class="btn btn-info waves-effect waves-light btn-sm" onclick="previouspages('ManageFeeTypes',null)">
                                            Previous Page
                                        </button>
                                        <button type="button" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Searchclearform('Searchfeetermform')" id="BtnClear">
                                            Clear
                                        </button>
                                        <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="btnsearch">Search</button>
                                        <button type="button" class="btn btn-primary waves-effect waves-light btn-sm" onclick="nextpages('ManageBankAccounts',null)">
                                            Next Page
                                        </button>
                                    </div>
                                </form>
                            </div>                     
                </div>
            </div>
            <div class="col-md-12 col-lg-12 mb-3">
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <span class="text-header">
                            YOUR SEARCH RESULTED
                            <span id="Recordscount" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span>
                            RECORDS.
                        </span>
                    </div>
                    <div class="table-responsive text-nowrap">
                        <table id="Feetermstbl" class="table table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>S. No.</th>
                                    <th>Fee Term</th>
                                    <th>Fee Type</th>
                                    <th>Description</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div id="Addnewfeeterm_div1">

        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>
<script src="~/js/Managefeeterms.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}