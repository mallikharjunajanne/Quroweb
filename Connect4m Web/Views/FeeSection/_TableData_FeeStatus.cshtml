@model List<Feestatusdetails>

<div class="col-md-12 col-lg-12 mb-3">
    <div class="card mb-4">
        <div class="card-header bg-danger text-white text-header">SMS CREDITS</div>
        <div class="row mb-1">
            <label class="col-sm-4 col-form-label space text-end" for="basic-default-name">Total Credits</label>
            <div class="col-sm-4">
                <label class="text-danger control-label col-form-label text-end">@ViewBag.TotalCredits</label>
            </div>
        </div>
        <div class="row mb-1">
            <label class="col-sm-4 col-form-label space text-end" for="basic-default-name">Used Credits</label>
            <div class="col-sm-4">
                <label class="text-danger control-label col-form-label text-end">@ViewBag.UsedCredits</label>
            </div>
        </div>
        <div class="row mb-1">
            <label class="col-sm-4 col-form-label space text-end" for="basic-default-name">Remaining Credits</label>
            <div class="col-sm-4">
                <label class="text-danger control-label col-form-label text-end">@ViewBag.RemCredits</label>
            </div>
        </div>
    </div>
</div>
@if (@ViewBag.ItemsCount > 0)
{
    <div class="col-md-12 col-lg-12 mb-3">
        <a href="#" id="exportToExcelButton" class="btn btn-label-linkedin waves-effect">Export to Excel Expand Grid</a>
        <div class="row">
            <div class="col-sm-2">
                <input type="checkbox" class="form-check-input" id="chksmsstudent">
                <label class="form-check-label" for="SmsToStudent" id="lblchksmsstudent">Sms To Student</label>
            </div>
            <div class="col-sm-2">
                <input type="checkbox" class="form-check-input" id="chksmsparents">
                <label class="form-check-label" for="SmsToStudent" id="lblchksmsparents">Sms To Parent</label>
            </div>
            <div class="col-sm-3">
                <input type="checkbox" class="form-check-input" id="chkemailstudents">
                <label class="form-check-label" for="SmsToStudent" id="lblchkemailstudents">Send Email To Students</label>
            </div>
            <div class="col-sm-3">
                <input type="checkbox" class="form-check-input" id="chkemailparents">
                <label class="form-check-label" for="SmsToStudent" id="lblchkemailparents">Send Email To Parents</label>
            </div>
            <div class="col-sm-3">
                <input type="checkbox" class="form-check-input" id="chkCheckAll">
                <label class="form-check-label" id="lblchkCheckAll">Check All</label>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header bg-danger text-white text-header">
                YOUR SEARCH RESULTED
                <span class="badge badge-center rounded-pill bg-primary bg-glow text-header"> @ViewBag.ItemsCount </span>
                RECORDS FOR <span id="Typeoffspid" class="text-header" value="@ViewBag.ButtonName"> @ViewBag.ButtonName </span>.
            </div>
            <div class="table-responsive text-nowrap" id="Admissiontbldiv">
                <table id="Feedetailstbl" class="table table-bordered dataTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Sl. No</th>
                            <th>Select</th>
                            <th>Student Name</th>
                            <th>Program</th>
                            <th>Batch</th>
                            <th>Fee Amount</th>
                            <th>Discount Type	</th>
                            <th>Discount Amount</th>
                            <th>Paid Amount</th>
                            <th>Due Amount</th>
                            <th>Student Mobile</th>
                            <th>StudentSmsStatus</th>
                            <th>Student EMail</th>
                            <th>Parent Name</th>
                            <th>Parent Mobile</th>
                            <th>ParentSmsStatus</th>
                            <th>Parent EMail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int SNO_ = 1;}
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@SNO_</td>
                                <td align="center" width="180px"><input type="checkbox" id="Check_Box_@item.Studentid" class="userCheckbox Userfeetypechk form-check-input " /></td>
                                <td align="left">
                                    <span style="font-weight: 600; cursor: pointer; text-decoration: underline; color: blue; " class="user-info" onclick="navigateToUserInfoAction('@item.Studentid', 'div_@item.Studentid')" data-user-id="@item.Studentid">@item.StudentName</span>
                                    <div id="div_@item.Studentid" style="display:none;"></div>
                                </td>
                                <td>@item.Program</td>
                                <td>@item.Batch</td>
                                <td>@item.FeeAmount</td>
                                <td>@(string.IsNullOrEmpty(item.ConcedingTypeName) ? "NA" : item.ConcedingTypeName)</td>
                                <td>@(item.ConcedingAmount == 0 ? "Nill" : item.ConcedingAmount.ToString())</td>
                                @*<td>@item.ConcedingTypeName</td>*@
                                @*<td>@item.ConcedingAmount</td>*@
                                <td>@item.FeePaid</td>
                                <td>@item.DueAmount</td>
                                <td>@item.StudentMobile</td>
                                <td>@item.StudentSmsStatus</td>
                                <td>@item.StudentEmail</td>
                                <td>@item.ParentName</td>
                                <td>@item.ParentPhone</td>
                                <td>@item.ParentSmsStatus</td>
                                <td>@item.ParentEmail</td>
                            </tr>
                            SNO_++;
                        }
                    </tbody>
                </table>
                <div class="text-center">
                    <button class="btn btn-success waves-effect waves-light btn-sm" id="GoToStep1btn"> Go To Step 1 </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-12 col-lg-12 mb-3" id="MessagecontentDiv2" style="display:none;">
        <div class="card mb-4">
            <div class="card-header bg-danger text-white text-header">TYPE MESSAGE</div>
            <div class="card-body">
                <div class="row">
                    <div class="row mb-2">
                        <label class="col-sm-4 col-form-label space text-end" for="basic-default-name">Type Message</label>
                        <div class="col-sm-5">
                            <textarea class="form-control" cols="8" rows="4" id="Subjecttxtid"></textarea>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label class="col-sm-2 col-form-label  text-end" for="basic-default-name"></label>
                        <div class="col-sm-10">
                            <span class="text-danger text-validation"> NOTE : The Messege Type here will send as subject for Email and Concatinates to Default Message.</span>
                        </div>
                    </div>
                    <div class="row justify-content-center text-center">
                        <div class="col-sm-12">
                            @*<button class="btn btn-info waves-effect waves-light btn-sm" id="btnPreview">Preview</button>*@
                            <button class="btn btn-info waves-effect waves-light btn-sm" id="btnPreview">Preview</button>
                            <span class="Spantext" title="NOTE: Preview will come for selected users if they have Mobile Number and SmsStatus true.">
                                <i>?</i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    //SMS PREVIEW FOR STUDENTS TABLE CODE START
    <div class="col-md-12 col-lg-12 mb-3" id="divPreviewofStudents" style="display:none;">
        <div class="card mb-4">
            <div class="card-header bg-danger text-white text-header">SMS PREVIEW FOR STUDENTS</div>
            <div class="table-responsive text-nowrap" style="max-height: 300px; overflow-y: auto;">
                <table id="tblStudentSMS" class="table table-bordered dataTable">
                    <thead class="table-dark">
                        <tr><th>Sl. No</th><th>SMS</th><th>Mobile Number</th><th>Sms Status</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    //SMS PREVIEW FOR STUDENTS TABLE CODE END

    //SMS PREVIEW FOR PARENTS TABLE CODE START
    <div class="col-md-12 col-lg-12 mb-3" id="divPreviewofParents" style="display:none;">
        <div class="card mb-4">
            <div class="card-header bg-danger text-white text-header">SMS PREVIEW FOR PARENTS</div>
            <div class="table-responsive text-nowrap" style="max-height: 300px; overflow-y: auto;">
                <table id="tblParentsSMS" class="table table-bordered dataTable">
                    <thead class="table-dark">
                        <tr><th>Sl. No</th><th>SMS</th><th>Mobile Number</th><th>Sms Status</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    //SMS PREVIEW FOR PARENTS TABLE CODE END


    //EMAIL PREVIEW FOR STUDENTS TABLE CODE START
    <div class="col-md-12 col-lg-12 mb-3" id="divPreviewofStudentsEmail" style="display:none;">
        <div class="card mb-4">
            <div class="card-header bg-danger text-white text-header">EMAIL PREVIEW FOR STUDENTS</div>
            <div class="table-responsive text-nowrap" style="max-height: 300px; overflow-y: auto;">
                <table id="tblStudentEmail" class="table table-bordered dataTable">
                    <thead class="table-dark">
                        <tr><th>Sl. No</th><th>Email</th><th>Email Id</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
    //EMAIL PREVIEW FOR STUDENTS TABLE CODE END

    //EMAIL PREVIEW FOR PARENTS TABLE CODE START
    <div class="col-md-12 col-lg-12 mb-3" id="divPreviewofParentEmail" style="display:none;">
        <div class="card mb-4">
            <div class="card-header bg-danger text-white text-header">EMAIL PREVIEW FOR PARENTS</div>
            <div class="table-responsive text-nowrap" style="max-height: 300px; overflow-y: auto;">
                <table id="tblParentEmail" class="table table-bordered dataTable">
                    <thead class="table-dark">
                        <tr><th>Sl. No</th><th>Email</th><th>Email Id</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div> 
    //EMAIL PREVIEW FOR PARENTS TABLE CODE END

    <div class="text-center">
        <button class="btn btn-success waves-effect waves-light btn-sm" id="btnPost" style="display:none;"> Send</button>
    </div>
}
else
{
    <span class="text-danger text-validation">Your search resulted 0 records.</span>
}



<script>
    var selectedStudentMobileNumbers = [];
    var selectedParentMobileNumbers = [];
    var selectedStudentEmail = [];
    var selectedParentEmail = [];
    var selectedStudentsmsstatus = [];
    var selectedParentsmsStatus = [];
    var selectedStudentids = [];

    $('#GoToStep1btn').click(function (e) {
        //debugger;
        loaddingimg.css('display', 'block');

        $('#divPreviewofStudents').hide();
        $('#divPreviewofParents').hide();
        $('#divPreviewofStudentsEmail').hide();
        $('#divPreviewofParentEmail').hide();
        $('#btnPost').hide();
        $('#Subjecttxtid').val('');
        $('#tblStudentSMS tbody').empty();
        $('#tblParentsSMS tbody').empty();
        $('#tblStudentEmail tbody').empty();
        $('#tblParentEmail tbody').empty();



        $('#Commonerrormessage').text('');
        e.preventDefault();
        var tableCheckboxes = document.querySelectorAll('.userCheckbox');
        var tableCheckboxesChecked = false;
        for (var i = 0; i < tableCheckboxes.length; i++) {
            if (tableCheckboxes[i].checked) {
                tableCheckboxesChecked = true;
                break;
            }
        }

        if (!$('#chksmsstudent').prop('checked') && !$('#chksmsparents').prop('checked') && !$('#chkemailstudents').prop('checked') && !$('#chkemailparents').prop('checked')) {
            $('#Commonerrormessage').text('Please make atleast one selection to send SMS or EMAIL.');
            $('html, body').animate({
                scrollTop: $('#Commonerrormessage').offset().top
            }, 1000);
            loaddingimg.css('display', 'none');

        }
        else if (!tableCheckboxesChecked) {
            $('#Commonerrormessage').text('Please select at least one student to send SMS or EMAIL.');
            $('html, body').animate({
                scrollTop: $('#Commonerrormessage').offset().top
            }, 1000);
            loaddingimg.css('display', 'none');
        }
        else {

            $('.userCheckbox:checked').each(function () {
                //debugger;
                var $row = $(this).closest('tr');
                var studentids = $(this).attr('id').replace('Check_Box_', '');
                var studentMobile = $row.find('td:eq(10)').text();
                var studentsmsstatus = $row.find('td:eq(11)').text();
                var studentEmail = $row.find('td:eq(12)').text();
                var parentMobile = $row.find('td:eq(14)').text();
                var parentEmail = $row.find('td:eq(16)').text();
                var parentsmsstatus = $row.find('td:eq(15)').text();

                //debugger;
                selectedStudentids.push(studentids);

                // Determine which communication options are selected
                if ($('#chksmsstudent').prop('checked')) {
                    selectedStudentMobileNumbers.push(studentMobile);
                    selectedStudentsmsstatus.push(studentsmsstatus);
                }
                if ($('#chksmsparents').prop('checked')) {
                    selectedParentMobileNumbers.push(parentMobile);
                    selectedParentsmsStatus.push(parentsmsstatus);
                }
                if ($('#chkemailstudents').prop('checked')) {
                    selectedStudentEmail.push(studentEmail);
                }
                if ($('#chkemailparents').prop('checked')) {
                    selectedParentEmail.push(parentEmail);
                }
            });

            var collectedData = {
                studentMobileNumbers: selectedStudentMobileNumbers,
                parentMobileNumbers: selectedParentMobileNumbers,
                studentEmails: selectedStudentEmail,
                parentEmails: selectedParentEmail,
                Studentsmsstatus: selectedStudentsmsstatus,
                Parentsmsstatus: selectedParentsmsStatus,
            }

            //console.log('Collected Data:', collectedData);
            $('#MessagecontentDiv2').show();
            $('#Commonerrormessage').text('');
            loaddingimg.css('display', 'none');
        }
    });

    $('#btnPreview').click(function () {

        debugger;
        loaddingimg.css('display', 'block');

        $('#tblStudentSMS tbody').empty();
        $('#tblParentsSMS tbody').empty();
        $('#tblStudentEmail tbody').empty();
        $('#tblParentEmail tbody').empty();

        let strFeeTypesPreview = '';
        let strFeeTypesParentsPreview = '';
        var intCount = 0;
        var intCount1 = 0;
        var intCount2 = 0;
        var intCount3 = 0;
        var intCount4 = 0;
        var MessageStudentsPhNo = "";
        var MessageParentsPhNo = "";
        var EmailstringStudents = "";
        var EmailstringParents = "";
        var ADMISSIONPROCESS_SMS = "ON";
        var smsText = $('#Subjecttxtid').val().trim();
        var Feetermsddltext = $('#Feetermsddl option:selected').text();
        //var ButtonTypeoffspid=$('#Typeoffspid').val();
        var ButtonTypeoffspid =$("#Typeoffspid").text().trim();

        if ($('#chksmsstudent').is(':checked') || $('#chksmsparents').is(':checked') || $('#chkemailstudents').is(':checked') || $('#chkemailparents').is(':checked')) {
            //debugger;

            // Iterate over each checkbox in the table
            $('#Feedetailstbl tbody tr').each(function () {
                let checkbox = $(this).find('td:eq(1) input[type="checkbox"].userCheckbox');
                if (!checkbox.is(':checked')) {
                    intCount++;
                }
            });

            // Check if all checkboxes are unchecked
            if (intCount === $('#Feedetailstbl tbody input[type="checkbox"].userCheckbox').length) {
                var roleText = $('#Roleddl option:selected').text(); // Get the selected role text
                $('#Commonerrormessage').text('Please Select At least One ' + roleText + ' to Send SMS or Email.');
                $('#divPreviewofParents, #divPreviewofStudents, #divPreviewofStudentsEmail, #divPreviewofParentEmail').hide();
                $('#btnPost').hide();
                window.scrollTo(0, 0);
                loaddingimg.css('display', 'none');
                return; // Exit the function if no checkboxes are selected
            }

            // Check if the SMS text is empty
            if (smsText === "") {
                $('#Commonerrormessage').text('Please enter the text you want to send.');
                $('#divPreviewofParents, #divPreviewofStudents, #divPreviewofStudentsEmail, #divPreviewofParentEmail').hide();
                $('#btnPost').hide();
                window.scrollTo(0, 0);
                loaddingimg.css('display', 'none');
                return; // Exit the function
            }

            // Build fee types preview string
            $('.Feetypechk:checked').each(function () {
                //debugger;
                if (strFeeTypesPreview === '') {
                    strFeeTypesPreview = $(this).next('label').text(); // Get the label text
                } else {
                    strFeeTypesPreview += ',' + $(this).next('label').text();
                }
            });

            $('.Feetypechk:checked').each(function () {
                /*debugger;*/
                if (strFeeTypesParentsPreview === '') {
                    strFeeTypesParentsPreview = $(this).next('label').text(); // Get the label text
                } else {
                    strFeeTypesParentsPreview += ',' + $(this).next('label').text();
                }
            });

            /*if ($('#chksmsstudent').is(':checked')) {*/
            if ($('#chksmsstudent').is(':checked') || $('#chksmsparents').is(':checked') || $('#chkemailstudents').is(':checked') || $('#chkemailparents').is(':checked')) {

                $('#Feedetailstbl tbody tr').each(function () {
                    debugger;
                    // Get specific column data (e.g., 0 for first column, 1 for second)
                    let firstColumnData = $(this).find('td:eq(0)').text().trim();
                    var studentids = $(this).find('input[type="checkbox"]').attr('id').replace('Check_Box_', '');
                    //var studentids = $(this).find('id').replace('Check_Box_', '');
                    // Get the checkbox in the first column of the current row
                    let isChecked = $(this).find('input[type="checkbox"].userCheckbox').prop('checked');  // Returns true if checked, false if unchecked
                    if (isChecked) {

                        let secondColumnData = $(this).find('td:eq(1)').text().trim();
                        let StudentName = $(this).find('td:eq(2)').text().trim();
                        let Program = $(this).find('td:eq(3)').text().trim();
                        let Batch = $(this).find('td:eq(4)').text().trim();
                        let FeeAmount = $(this).find('td:eq(5)').text().trim();
                        let DiscountType = $(this).find('td:eq(6)').text().trim();
                        let DiscountAmount = $(this).find('td:eq(7)').text().trim();
                        let PaidAmount = $(this).find('td:eq(8)').text().trim();
                        let DueAmount = $(this).find('td:eq(9)').text().trim();
                        let StudentMobile = $(this).find('td:eq(10)').text().trim();
                        let StudentSmsStatus = $(this).find('td:eq(11)').text().trim();
                        let StudentEMail = $(this).find('td:eq(12)').text().trim();
                        let ParentName = $(this).find('td:eq(13)').text().trim();
                        let ParentMobile = $(this).find('td:eq(14)').text().trim();
                        let ParentSmsStatus = $(this).find('td:eq(15)').text().trim();
                        let ParentEMail = $(this).find('td:eq(16)').text().trim();

                        let isValidStudentMobile = /^\d{10}$/.test(StudentMobile) && /^[6-9]/.test(StudentMobile);
                        let isValidParentMobile = /^\d{10}$/.test(ParentMobile) && /^[6-9]/.test(ParentMobile);

                        if ($('#chksmsstudent').is(':checked')) {
                            if (isValidStudentMobile) {
                                if (StudentMobile !== '') {
                                    if (StudentSmsStatus.toUpperCase() === 'TRUE') {
                                        if (ButtonTypeoffspid.toUpperCase() === "PARTIAL FEE") {
                                            if (Feetermsddltext.toUpperCase() === 'TERM') {
                                                if (DiscountType === "NA") {
                                                    MessageStudentsPhNo = `Dear ${StudentName}, Fee Details of ${Feetermsddltext}-${strFeeTypesPreview} is ${FeeAmount}. You have paid ${PaidAmount}. Due Amount is ${DueAmount}. ${smsText}`;
                                                }
                                                else {
                                                    MessageStudentsPhNo = `Dear ${StudentName}, Fee Details of ${Feetermsddltext}-${strFeeTypesPreview} is ${FeeAmount}, Alloted Discount is ${DiscountAmount} Under ${DiscountType}. You have paid ${PaidAmount}. Due Amount is ${DueAmount}. ${smsText}`;
                                                }
                                            }
                                            else {
                                                if (DiscountType === "NA") {
                                                    MessageStudentsPhNo = `Dear ${StudentName}, Fee Details of Term ${Feetermsddltext}-${strFeeTypesPreview} is ${FeeAmount}. You have paid ${PaidAmount}. Due Amount is ${DueAmount}. ${smsText}`;
                                                }
                                                else {
                                                    MessageStudentsPhNo = `Dear ${StudentName}, Fee Details of Term ${Feetermsddltext}-${strFeeTypesPreview} is ${FeeAmount}, Alloted Discount is ${DiscountAmount} Under ${DiscountType}. You have paid ${PaidAmount}. Due Amount is ${DueAmount}. ${smsText}`;
                                                }
                                            }
                                        }
                                        else if (ButtonTypeoffspid.toUpperCase() === "NO FEE") {
                                            if (Feetermsddltext.toUpperCase() === 'TERM') {
                                                if (DiscountType === "NA") {
                                                    MessageStudentsPhNo = `Dear ${StudentName}, Fee Details of ${Feetermsddltext}-${strFeeTypesPreview} is ${FeeAmount}. Due Amount is  ${DueAmount}. ${smsText}`;
                                                }
                                                else {
                                                    MessageStudentsPhNo = `Dear ${StudentName}, Fee Details of ${Feetermsddltext}-${strFeeTypesPreview} is ${FeeAmount}, Alloted Discount is ${DiscountAmount}.  Under  ${DiscountType} .Due Amount is ${DueAmount}.${smsText}`;
                                                }
                                            }
                                            else {
                                                if (DiscountType === "NA") {
                                                    MessageStudentsPhNo = `Dear ${StudentName}, Fee Details of Term ${Feetermsddltext}-${strFeeTypesPreview} is ${FeeAmount}.Due Amount is ${DueAmount}.${smsText}`;
                                                }
                                                else {
                                                    MessageStudentsPhNo = `Dear ${StudentName}, Fee Details of Term  ${Feetermsddltext}-${strFeeTypesPreview} is ${FeeAmount}, Alloted Discount is ${DueAmount} Under ${DiscountType}. Due Amount is ${DueAmount} .${smsText}`;
                                                }
                                            }
                                        }
                                    }

                                    // Create a new row
                                    let NewStudentSMSRow = `<tr>
                                        <td>${intCount1 + 1}</td>
                                        <td>${MessageStudentsPhNo}</td>
                                        <td>${StudentMobile}</td>
                                        <td>${StudentSmsStatus}</td>
                                      </tr>`;

                                    // Append the new row to the tbody of the target table
                                    $('#tblStudentSMS tbody').append(NewStudentSMSRow); // Replace #YourTargetTable with the actual table ID or class
                                    intCount1++;
                                }
                            }
                        }

                        if ($('#chksmsparents').is(':checked')) {
                            if (isValidParentMobile) {
                                if (ParentMobile !== '') {
                                    if (ParentSmsStatus.toUpperCase() === 'TRUE') {
                                        if (ButtonTypeoffspid.toUpperCase() === "PARTIAL FEE") {
                                            //if (getXMLNodeValueByKey("ADMISSIONPROCESS_SMS", getXMLConfigPath()).toUpperCase() === "ON") {
                                            if (ADMISSIONPROCESS_SMS.toUpperCase() === "ON") {
                                                if (Feetermsddltext.toUpperCase() === 'TERM') {
                                                    MessageParentsPhNo = `Dear Parent, This is to remind you to remit the Fee Amount of ${Feetermsddltext}-${strFeeTypesParentsPreview} ${smsText}. Please Ignore this message if paid.`;
                                                }
                                                else {
                                                    MessageParentsPhNo = `Dear Parent, This is to remind you to remit the Fee Amount of ${Feetermsddltext}-${strFeeTypesParentsPreview} ${smsText}. Please Ignore this message if paid.`;
                                                }
                                            }
                                            else {
                                                if (Feetermsddltext.toUpperCase() === 'TERM') {
                                                    if (DiscountType === "NA") {
                                                        MessageParentsPhNo = `Dear Parent your ward ${StudentName} Fee Details of ${Feetermsddltext}-${strFeeTypesParentsPreview} is ${FeeAmount}. You had paid ${PaidAmount}. Due Amount is ${DueAmount}. ${smsText}`;
                                                    }

                                                    else {
                                                        MessageParentsPhNo = `Dear Parent your ward ${StudentName} Fee Details of ${Feetermsddltext}-${strFeeTypesParentsPreview} is ${FeeAmount}, Alloted Discount is ${DiscountAmount} Under ${DiscountType}. You had paid ${PaidAmount}. Due Amount is ${DueAmount}. ${smsText}`;
                                                    }

                                                }
                                                else {
                                                    if (DiscountType === "NA") {
                                                        MessageParentsPhNo = `Dear Parent your ward ${StudentName} Fee Details of Term ${Feetermsddltext}-${strFeeTypesParentsPreview} is ${FeeAmount}. You had paid ${PaidAmount}. Due Amount is ${DueAmount}. ${smsText}`;
                                                    }
                                                    else {
                                                        MessageParentsPhNo = `Dear Parent your ward ${StudentName} Fee Details of Term ${Feetermsddltext}-${strFeeTypesParentsPreview} is ${FeeAmount}, Alloted Discount is ${DiscountAmount} Under ${DiscountType}. You had paid ${PaidAmount}. Due Amount is ${DueAmount}. ${smsText}`;
                                                    }
                                                }
                                            }

                                        }
                                        else if (ButtonTypeoffspid.toUpperCase() === "NO FEE") {
