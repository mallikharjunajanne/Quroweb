@model Connect4m_Web.Models.Attendenceproperites.UserScreen.BestPerformer
@{
    ViewData["Title"] = "MANAGE BEST PERFORMER";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    @*Error messages ids*@
    @*Errormessage
    UpdatevalidationMessage
    Errmsg
    UpdatevalidationMessage*@
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-3 text-center text-header">MANAGE BEST PERFORMERS</h4>
        <div class="row mb-2">
            <span class="text-danger" id="Errormessage"></span>
            <div class="col-sm-12 text-end" id="Manageholidays_Heaingmaindiv0">
                <button type="button" class="btn btn-label-linkedin waves-effect btn-sm" id="addnewbestperformer"> Create Best Performer</button>
            </div>
            <div id="Managebestperoformerdmaindiv">
                <div class="col-md-12 col-lg-12 mb-3">
                    <span class="text-danger" id="UpdatevalidationMessage"></span>
                    <div class="card mb-4">
                        <div class="card-header bg-danger text-white text-header d-flex align-items-center justify-content-between">
                            SEARCH BEST PERFORMERS
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <label class="control-label col-sm-4 col-form-label text-end space">Title</label>
                                <div class="col-sm-4">
                                    <input type="text" class="form-control" name="Title" id="Titletxtid" />
                                </div>
                            </div>
                            <div class="col-sm-12 text-center">
                                <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="Mainview_Clearbtn">Clear</button>
                                <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="Mainview_Searchbtn">Search</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="ManageHolidaystbl_containerdivId">
                    <span id="Errmsg" class="text-danger"></span>
                    <div class="col-md-12 col-lg-12 mb-3">
                        <span class="text-danger" id="UpdatevalidationMessage"></span>
                        <div class="card mb-4">
                            <div class="card-header bg-danger text-white text-header">
                                YOUR SEARCH RESULTED
                                <span id="ManagebestperformertblCount" class="badge badge-center rounded-pill bg-primary bg-glow text-header"> 0 </span> 
                                RECORDS.
                            </div>
                            <table class="table table-bordered" id="Managebestperformertbl">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 5%;">SNO</th>
                                        <th style="width: 30%;">Title</th>
                                        <th>Best Performer(User)</th>
                                        <th>Display Until</th>
                                        <th>Delete</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div id="Managebestperoformerd_Insertdiv2"></div>
            <div id="Managebestperoformerd_Updatediv3"></div>
        </div>
    </div>
</body>
</html>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>


<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>

<script src="~/js/Managebestperformer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
