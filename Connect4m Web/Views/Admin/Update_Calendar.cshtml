@model Connect4m_Web.Models.Attendenceproperites.UserScreen.EventsClander
@{
    ViewData["Title"] = "Update_Calendar";
    Layout = null;
}



    <div class="col-md-12 col-lg-12 mb-3">
        <div class="card mb-4">
            <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">UPDATE EVENTS <small>* INDICATES MANDATORY FIELD</small></div>
            <div class="card-body">
                <div class="row col">
                    <form id="Eventsupdatingform">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row mb-3">
                            <label class="control-label col-sm-4 col-form-label text-end required space">Event Date</label>
                            <div class="col-sm-4">
                                <input type="date" asp-for="dateofevent" class="form-control" />
                                <input type="hidden" asp-for="EventId" class="form-control" />
                                <span class="text-danger" asp-validation-for="dateofevent"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="control-label col-sm-4 col-form-label text-end required space">Event Title</label>
                            <div class="col-sm-4">
                                <input type="text" class="form-control" asp-for="EventTitle" />
                                <span class="text-danger" asp-validation-for="EventTitle"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="control-label col-sm-4 col-form-label text-end space">Event Description</label>
                            <div class="col-sm-4">
                                <textarea asp-for="EventDescription" class="form-control"></textarea>
                            </div>
                        </div>
                        <div class="col-sm-12 text-center">
                            <button type="button" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Deletefunction(@Model.EventId)" id="btndelete">Delete</button>
                            <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="BackToSearchUbtn">BackToSearch</button>
                            <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="btnupdate">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>


<script src="~/js/Managecalendar.js"></script>