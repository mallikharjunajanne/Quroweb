@model Connect4m_Web.Models.Attendenceproperites.UserScreen.SearchDeposit
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head></head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="text-center text-header">AMOUNT DEPOSIT SCREEN</h4>
        <span id="Commoneerrormessage" class="text-validation"></span>
        <div class="row mb-2" id="Bankdipositdiv">
            <div class="col-sm-12 text-end">
                <button type="button" class="btn btn-label-linkedin waves-effect btn-sm" onclick="Newdiposit()">
                    Enter New Deposit
                </button>
            </div>
            <div class="col-md-12 col-lg-12">
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white text-header">SEARCH</div>
                    <div class="card-body">
                        <form id="BankdepositSearchForm" enctype="multipart/form-data">
                            <div class="row">
                                <div class="row mb-3">
                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label space text-end" for="basic-default-name">Payment Mode</label>
                                        <div class="col-sm-4">
                                          <select asp-for="PaymentModeId" id="PaymentModeSearchddl" class="form-select"></select>
                                        </div>
                                        <label class="col-sm-2 col-form-label  text-end" for="basic-default-name"></label>
                                        <div class="col-sm-4"></div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label space text-end" for="basic-default-name">Start Date</label>
                                        <div class="col-sm-4">
                                            <input type="date" asp-for="StartDate" class="form-control" id="Startdatetxt" name="Startdate" />
                                        </div>
                                        <label class="col-sm-2 col-form-label  text-end" for="basic-default-name">End Date</label>
                                        <div class="col-sm-4">
                                            <input type="date" asp-for="EndDate" class="form-control" id="Enddatetxt" name="Enddate" />
                                        </div>
                                    </div>
                                </div>
                                <div class="justify-content-center text-center">
                                    <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Clearform('BankdepositSearchForm')">Clear</button>
                                    <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Searchbtn">Search</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-12 col-lg-12">
                <div id="Amountdepositdivexporttoexcel" class="text-right">
                    <a href="javascript:void(0)" id="AmountdepositExportToExcel" onclick="Exporttoexcelfun();" 
                       class="btn rounded-pill btn-info waves-effect waves-light btn-sm">Export to Excel</a>
                </div>
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white text-header">
                        TOTAL NUMBER OF <span id="Recordscount" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span> RECORDS
                    </div>
                    <div class="table-responsive text-nowrap card-datatable " id="Bankdeposittbldivid"></div>
                </div>
            </div>
        </div>
        <div id="Amountdepositdiv1">

        </div>
    </div>
</body>
</html>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
@*<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>*@
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
<script src="~/js/Bankdeposit.js"></script>
<script src="~/js/CommonScripts.js"></script>
@*<script src="~/Datatable/jquery.dataTables.min.js"></script>*@

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
