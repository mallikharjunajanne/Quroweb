    /*---***---Goto  Step 2 button click fire function  code start---***---*/

    $('#Feetermddl').change(function () {
        var GetSelectedvalue = $('#Feetermddl').val();
        Firstddlbysecoundddl(GetSelectedvalue);
    });
    function Firstddlbysecoundddl(GetSelectedvalue) {
        fetchDataAndPopulateDropdown(                                             //==== << ** Subclassification Dropdown ** >>
            '/FeeSection/Frfeetypeddl?FeeTermIds=' + GetSelectedvalue,// URL for data fetching
