@model Connect4m_Web.Models.LMSproperties.ManageSubCategory
@{
    ViewData["Title"] = "Manage Sub Category";
    Layout = null;
}
<html>
<head>
    <title>@ViewData["Title"]</title>
    <style>
        #appendinsertmanagecategory {
            display: none
        }
    </style>
    @*<link href="~/css/CommonStyle.css" rel="stylesheet" />*@
</head>
<body>
    <h4 class="mb-3 text-center text-header">MANAGE SUB CATEGORY</h4>
    <div class="row mb-2">
        <div class="col-md-12 col-lg-12 mb-3">
            <div id="appendsearchmanagesubcategory">
                <div class="demo-inline-spacing text-end">
                    <button type="button" class="btn rounded-pill btn-info waves-effect waves-light btn-sm" id="addnewmanagesubcategorybtn">
                        Create New Sub Category
                    </button>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
                        @*<h5 class="mb-0">*@
                        <span id="AddNewText_Span_CreatePage" class="text-header">
                            MANAGE SUB CATEGORY
                        </span>
                        @*</h5>*@
                    </div>

                    <div class="card-body mb-2">

                        @*=============================  Form Start ================================*@
                        <form id="Serach_MSC">
                            <div>
                                <div class="row">
                                    <div class="col">

                                        @*=====================        TEXT BOX                 =================*@

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                            </div>
                                            <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="PayrollSubCategoryName"></label>
                                            <div class="col-sm-4 form-group">
                                                <input class="form-control" asp-for="PayrollSubCategoryName" id="PayrollSubCategoryName">

                                            </div>
                                            <div class="col-sm-3">
                                            </div>
                                        </div>

                                        @*=====================        TEXT BOX                 =================*@

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                            </div>
                                            <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="isLeaveApplicable"></label>
                                            <div class="col-sm-4" style="display:flex">


                                                <div class="form-check form-check-primary ">
                                                    <input asp-for="isLeaveApplicable" class="form-check-input" name="isLeaveApplicable" type="radio" value="0" checked>
                                                    <label class="form-check-label">
                                                        PayRoll
                                                    </label>
                                                </div>
                                                <div class="form-check form-check-primary ">
                                                    <input asp-for="isLeaveApplicable" class="form-check-input" name="isLeaveApplicable" type="radio" value="1">
                                                    <label class="form-check-label">
                                                        Leave
                                                    </label>
                                                </div>
                                                <div class="form-check form-check-primary ">
                                                    <input asp-for="isLeaveApplicable" class="form-check-input" name="isLeaveApplicable" type="radio" value="2">
                                                    <label class="form-check-label">
                                                        Both
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-sm-3">
                                            </div>

                                        </div>

                                        @*=====================         BUTTONS                =================*@

                                        <div class="row justify-content">
                                            <div class="col-sm-4">
                                            </div>

                                            <div class="col-sm-8">
                                                <button type="button" class="btn btn-info waves-effect waves-light btn-sm" id="backtopage_MSC" onclick="nextpage('SearchManageCatogory',null)">Previous Page</button>


                                                <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="clearform">Clear</button>
                                                <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="sub_tblMSC">Search</button>

                                                <button type="button" class="btn btn-primary waves-effect waves-light btn-sm" id="Nextpage_MC" onclick="nextpage('SearchManageEmployees',null)">Next Page</button>

                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </form>
                        @*=============================  Form End ================================*@

                    </div>
                    @*=============================  TABLE START ================================*@
                </div>
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <span class="text-header">
                            YOUR SEARCH RESULTS
                            <span id="totalrecords_Tranctions_MSC" class="badge badge-center rounded-pill bg-primary bg-glow text-header">0</span> RECORD(S).
                        </span>
                    </div>
                    <div class="table-responsive text-nowrap">
                        <table id="tblMSCsearchresults" class="link table table-hover table-bordered ">
                            <thead class="table-dark">


                                <tr>
                                    <th>
                                        S.No
                                    </th>
                                    <th>
                                        S.No
                                    </th>
                                    <th>
                                        Sub Category
                                    </th>
                                    <th>
                                        Category
                                    </th>
                                    <th>
                                        Description
                                    </th>
                                    <th>
                                        Delete
                                    </th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
                @*=============================  TABLE END ================================*@
            </div>

            <div id="appendinsertmanagesubcategory">

            </div>

        </div>
    </div>
</body>
</html>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@*<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>*@
@*<script src="~/lib/jquery/dist/jquery.js"></script>*@
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/js/PayRoll_4.js"></script>