@model Connect4m_Web.Models.LMSproperties.StaffAttendance
@{
    ViewData["Title"] = "AttendanceRegister";

}
@*<link href="~/css/CommonStyle.css" rel="stylesheet" />
    <link href="~/Datatable/jquery.dataTables.css" rel="stylesheet" />
    <link href="~/assets/css/vendors/font-awesome.css" rel="stylesheet" />*@


<!DOCTYPE html>
<html>
<head>
    <style>
        #appendstaffsearchatendance {
            display: none
        }
    </style>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">


        <h4 class="mb-4 text-center text-header">Attendance Register</h4>

        <!-- Examples -->
        <div class="row mb-2">
            <div class="col-md-12 col-lg-12 mb-3">
                @*<span class="ErrorMessageSpan"></span>*@
                @*<a id="BtnCreateNewSubjects" class="text-end" onclick="CreateNewSubjects()">Create Subject</a>*@
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between text-header">
                        <span id="AddNewText_Span_CreatePage">
                            SEARCH
                        </span>
                        @*<small class="text-muted float-end">Default label</small>*@
                    </div>
                    <div id="appendsearchmanageemployees">
                        <div class="card-body">
                            @*=============================  Form Start ================================*@
                            <form id="Serach_Staffregister" class="needs-validation was-validated" novalidate>
                                <div>
                                    <div class="row">
                                        <div class="col">
                                            <input type="text" value="@ViewBag.instancceidME" class="form-control" id="InstanceidforSAR" disabled hidden />

                                            @*=====================      =================*@

                                            @*=====================         DROP DOWN               =================*@

                                            <div class="row mb-3">

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="InstanceUserCode"></label>
                                                <div class="col-sm-4">
                                                    <input type="text" class="form-control" asp-for="InstanceUserCode">
                                                </div>

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="InstanceClassificationId"></label>
                                                <div class="col-sm-4">
                                                    <div class="position-relative" id="dropdown">
                                                        @Html.DropDownListFor(
                                                   x => x.InstanceClassificationId,
                                                    new SelectList(ViewBag.Department, "Value", "Text"),
                                                  "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_instanceclassficationstaff", @style = "color:black;" })

                                                    </div>
                                                </div>
                                            </div>
                                            @*=====================         DROP DOWN               =================*@

                                            <div class="row mb-3">

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="FirstName"></label>
                                                <div class="col-sm-4">
                                                    <input type="text" class="form-control" asp-for="FirstName">
                                                </div>

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="LastName"></label>
                                                <div class="col-sm-4">
                                                    <input type="text" class="form-control" asp-for="LastName">
                                                </div>

                                            </div>
                                            @*=====================         DROP DOWN               =================*@

                                            <div class="row mb-3">

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="Month"></label>
                                                <div class="col-sm-4">
                                                    <div class="position-relative" id="dropdown">
                                                        @Html.DropDownListFor(
                                                   x => x.Month,
                                                    new SelectList(ViewBag.Months, "Value", "Text"),
                                                  "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_staff_month", @style = "color:black;", @required = "required" })
                                                        <span asp-validation-for="Month" class="text-danger"></span>
                                                    </div>
                                                </div>

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="Year"></label>
                                                <div class="col-sm-4">
                                                    <div class="position-relative" id="dropdown">
                                                        @Html.DropDownListFor(
                                                   x => x.Year,
                                                    new SelectList(ViewBag.Years, "Value", "Text"),
                                                  "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_staff_Year", @style = "color:black;", @required = "required" })
                                                        <span asp-validation-for="Year" class="text-danger"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            @*=====================         DROP DOWN               =================*@

                                            <div class="row mb-3">

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="PayrollCategory"></label>
                                                <div class="col-sm-4">
                                                    <div class="position-relative" id="dropdown">
                                                        @Html.DropDownListFor(
                                                   x => x.PayrollCategory,
                                                    new SelectList(ViewBag.PayrollCategory, "Value", "Text"),
                                                  "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_staff_PayrollCategory", @style = "color:black;" })

                                                    </div>
                                                </div>

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="PayrollSubCategory"></label>
                                                <div class="col-sm-4">
                                                    <div class="position-relative" id="dropdown">
                                                        @Html.DropDownListFor(
                                                   x => x.PayrollSubCategory,
                                                    new SelectList(ViewBag.PayRollSubCategory, "Value", "Text"),
                                                  "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_staff_PayRollSubCategory", @style = "color:black;", @multiple = "multiple" })
                                                        <span id="dropdown_staff_PayRollSubCategory_Clearselection" style="cursor: pointer; color: blue;"> Clear Selection</span>
                                                    </div>
                                                </div>
                                            </div>
                                            @*=====================         DROP DOWN               =================*@

                                            <div class="row mb-3">

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="LMSCategory"></label>
                                                <div class="col-sm-4">
                                                    <div class="position-relative" id="dropdown">
                                                        @Html.DropDownListFor(
                                                   x => x.LMSCategory,
                                                    new SelectList(ViewBag.LMSCategory, "Value", "Text"),
                                                  "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_staff_LMSCategory", @style = "color:black;" })

                                                    </div>
                                                </div>

                                                <label class="col-sm-2 col-form-label text-end" for="basic-default-name" asp-for="LMSSubCategory"></label>
                                                <div class="col-sm-4">
                                                    <div class="position-relative" id="dropdown">
                                                        @Html.DropDownListFor(
                                                   x => x.LMSSubCategory,
                                                    new SelectList(ViewBag.LMSSubCategory, "Value", "Text"),
                                                  "-------select-------", new { @class = "select2 form-select select2-hidden-accessible", @id = "dropdown_staff_LMSSubCategory", @style = "color:black;", @multiple = "multiple" })
                                                        <span id="dropdown_staff_LMSSubCategory_clearselection" style="cursor: pointer; color: blue;"> Clear Selection</span>
                                                    </div>
                                                </div>
                                            </div>

                                            @*=====================         BUTTONS                =================*@

                                            <div class="justify-content text-center">
                                                <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="clearForm('Serach_Staffregister')" id="clearform">Clear</button>
                                                <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="sub_tblPGE">Search</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                            @*=============================  Form End ================================*@
                        </div>
                    </div>
                </div>
            
            </div>

        </div>

        <div id="appendstaffsearchatendance"></div>
    </div>
</body>
</html>
<script src="~/lib/jquery/dist/jquery.js" type="text/javascript"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/Datatable/jquery.dataTables.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>
@*
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>*@
@*
    <script src="~/lib/jquery/dist/jquery.js"></script>*@
@*<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>*@

<script src="~/js/Staff_Attendance.js"></script>


<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.1/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>






