@model Connect4m_Web.Models.Attendenceproperites.UserScreen.Managequote
@{
    ViewData["Title"] = "Update_Quote";
    Layout = null;
}

<div class="col-md-12 col-lg-12 mb-3">
    <span id="Errormsg" class="text-validation"></span>
    <div class="card mb-4">
        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
            <span class="text-header">UPDATE QUOTE</span>
            <small class="text-header-small">* INDICATES REQUIRED FIELDS</small>
        </div>
        <div class="card-body">
            @*<div class="row">*@
                <div class="row col">
                    <form id="UpdateQuote" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row mb-3">
                            <label class="control-label col-sm-4 col-form-label required text-end space">Quote</label>
                            <div class="col-sm-4">
                                <input type="hidden" asp-for="QuoteId" id="QuoteId_txtid" />
                                <input type="text" asp-for="Quote" id="Quote_txtid" class="form-control" />
                                <span asp-validation-for="Quote" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="control-label col-sm-4 col-form-label required text-end space">Display Date</label>
                            <div class="col-sm-4">
                                <input type="date" asp-for="DisplayDate_" id="DisplayDate_txtid" class="form-control" />
                                <span asp-validation-for="DisplayDate_" class="text-danger" id="Error_Sp"></span>
                                <span class="text-danger" id="Error_Sp"></span>
                            </div>
                        </div>
                        <div class="col-sm-12 text-center">
                            @*<div class="col-sm-12">*@
                                <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="Dltbtn">Delete</button>
                                <button type="button" class="btn btn-dark waves-effect waves-light btn-sm" id="BackToSearchUbtn">BackToSearch</button>
                                <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" id="Updatebtn">Update</button>
                            @*</div>*@
                        </div>
                    </form>
                @*</div>*@
            </div>
        </div>
    </div>
</div>



<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script src="~/js/Managequote.js"></script>