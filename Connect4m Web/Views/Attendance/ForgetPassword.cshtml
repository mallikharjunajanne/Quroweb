@model Connect4m_Web.Models.LoginModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = null;
    //Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head></head>
<body data-screen-name="LoginPage">
    <div class="authentication-wrapper authentication-cover authentication-bg">
        <div class="authentication-inner row">  
            <div class="col-sm-12 row">

                <div class="col-sm-1">
                    <div class="row-2">
                        <label></label>
                    </div>
                </div>
                <div class="card mb-4 col-sm-10">
                    <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
                        <span class="text-header">  Forgot Password Details</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="row mb-2">
                                <label class="control-label col-sm-1 col-form-label"></label>
                                <label class="control-label col-sm-4 col-form-label">
                                    <b>Instructions</b> :-
                                </label>
                            </div>
                            <div class="row mb-1">
                                <label class="control-label col-sm-1 col-form-label"></label>
                                <label class="control-label col-sm-4 col-form-label">
                                    <b> 1.</b>Enter your User Id
                                </label>
                            </div>
                            <div class="row mb-1">
                                <label class="control-label col-sm-1 col-form-label"></label>
                                <label class="control-label col-sm-10 col-form-label">
                                    <b>2.</b>Enter the mobile number of the primary parent as registered in the school records.
                                </label>
                            </div>
                            <div class="row mb-1">
                                <label class="control-label col-sm-1 col-form-label"></label>
                                <label class="control-label col-sm-10 col-form-label">
                                    The new password will be sent over a SMS to the mobile number of the primary parent as available in the school records.
                                </label>
                            </div>
                        </div>

                        <form id="Forgetpasswordform" novalidate="novalidate">
                            <div class="row mb-2">
                                <label class="control-label col-sm-4 col-form-label text-end required space">User Id  </label>
                                <div class="col-sm-4">
                                    <input type="text" id="Useridtxt" class="form-control" placeholder="User Name" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label class="control-label col-sm-4 col-form-label text-end required space">Mobile Number </label>
                                <div class="col-sm-4">
                                    <input type="text" id="Mobilenumbertxt" class="form-control" placeholder="Mobile Number">
                                </div>
                            </div>
                            <div class="col-sm-12 text-center">
                                <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" id="btnclear">Clear</button>
                                <button type="submit" class="btn btn-success waves-effect waves-light btn-sm" onclick="Forgetpasswordbtn()" id="btnsearch">Submit</button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-sm-1"></div>
            </div>
        </div>
    </div>
</body>
</html>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
<script src="~/js/Forgetpassword.js"></script>