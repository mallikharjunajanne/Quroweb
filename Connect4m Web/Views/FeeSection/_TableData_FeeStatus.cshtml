    $("#btnPost").click(function () {
        debugger;
        $('#Commonerrormessage').text('');
        loaddingimg.css('display', 'block');

        let SMSStudentsRowData=[];
        let SMSParentsRowData=[];
        let EmailStudentsRowData=[];
        let EmailParentsRowData=[];

        if ($('#divPreviewofStudents').is(':visible')) {
            let headers = ['Sno', 'SMS', 'Mobile Number']; // Define your headers
            //debugger;
            // Get the row data with the desired structure
            let rows = $('#tblStudentSMS tbody tr').map(function (index) {
                let smsText = $(this).find('td:eq(1)').text().trim(); // Assuming SMS is in the second column (index 1)
                let mobileNumber = $(this).find('td:eq(2)').text().trim(); // Assuming Mobile Number is in the third column (index 2)
                // Validate mobile number
                //const isValidMobileNumber = /^6|7|8|9\d{8}$/.test(mobileNumber); // Check if it starts with 6-9 and has 10 digits
                const isValidMobileNumber = /^[6-9]\d{9}$/.test(mobileNumber.toString());

                if (isValidMobileNumber) {
                    return {
                        //Sno: index + 1, // Serial number (starting from 1)
                        SMS: smsText,
                        MobileNumber: mobileNumber
                    };
                }
            }).get().filter(Boolean);

            // Combine headers and row data
            //SMSStudentsRowData.push({ headers: headers });
            rows.forEach((row) => {
                SMSStudentsRowData.push(row);
            });
        }

        if ($('#divPreviewofParents').is(':visible')) {

            // Get the row data with the desired structure
            let rows = $('#tblParentsSMS tbody tr').map(function (index) {
                let smsText = $(this).find('td:eq(1)').text().trim(); // Assuming SMS is in the second column (index 1)
                let mobileNumber = $(this).find('td:eq(2)').text().trim(); // Assuming Mobile Number is in the third column (index 2)
                const isValidParentMobileNumber = /^[6-9]\d{9}$/.test(mobileNumber.toString());

                if (isValidParentMobileNumber) {
                    return {
                        //Sno: index, // Serial number
                        SMS: smsText,
                        MobileNumber: mobileNumber
                    };
                }

            }).get().filter(Boolean);

            // Combine headers and row data
            rows.forEach((row) => {
                SMSParentsRowData.push(row);
            });
        }

        if ($('#divPreviewofStudentsEmail').is(':visible')) {
            debugger;
            $('#tblStudentEmail tbody tr').each(function (index) {
                let smsText = $(this).find('td:eq(1)').text().trim(); // Assuming SMS is in the second column (index 1)
                let studentEmail = $(this).find('td:eq(2)').text().trim(); // Assuming Student Email is in the third column (index 2)
                var studentids = $(this).find('td:eq(2)').attr('id').replace('Studentemailids', '');
                // Directly push the data into the array
                EmailStudentsRowData.push({
                    //Sno: index, // Serial number
                    SMS: smsText,
                    StudentEmail: studentEmail,
                    Studentuserid: studentids,
                });
            });
        }

        if ($('#divPreviewofParentEmail').is(':visible')) {
            debugger;
            // Get the row data with the desired structure
            $('#tblParentEmail tbody tr').each(function (index) {
                let smsText = $(this).find('td:eq(1)').text().trim(); // Assuming SMS is in the second column (index 1)
                let studentEmail = $(this).find('td:eq(2)').text().trim(); // Assuming Student Email is in the third column (index 2)
                var studentids = $(this).find('td:eq(2)').attr('id').replace('StudenteParentmailids', '');
                // Directly push the data into the array
                EmailParentsRowData.push({
                    //Sno: index, // Serial number
                    SMS: smsText,
                    StudentEmail: studentEmail,
                    Parentuserid: studentids,
                });
            });
        }
               
        let data = {
            SMSStudents: SMSStudentsRowData,
            SMSParents: SMSParentsRowData,
            EmailStudents: EmailStudentsRowData,
            EmailParents: EmailParentsRowData
        };

        // Debugging the data before sending
        console.log("Sending data:", JSON.stringify(data));
        //debugger;
        $.ajax({
            url: '/FeeSection/Feestatuse_smsmailNotification',
            method: 'POST',
            contentType: 'application/json',  // JSON payload
            data: JSON.stringify(data),  // Convert data object to JSON string
            success: function (response) {
                // Handle the response
                var message = '';
                window.scrollTo(0, 500);
                if (response == "1") {

                    alert('An error occurred during the SMS sending process.');
                    loaddingimg.css('display', 'none');

                }
                else if (response == "-1") {
                    // Error handling
                    alert('SMS Sending Failed. Please try again.');
                }
                loaddingimg.css('display', 'none');
            },
            error: function (xhr, status, error) {
                // Error handling

                alert('SMS Successfully Sent to + ddlRole + (s). ');
