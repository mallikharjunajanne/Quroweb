@model Connect4m_Web.Models.Attendenceproperites.UserScreen.Managequote
@{
    //ViewData["Title"] = "ManageQuote";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
</head>
<body>
    <div class="flex-grow-1 container-p-y container-xxl">
        <h4 class="mb-1 text-center text-header">MANAGE QUOTE </h4>
        <div class="row mb-2">
            <div class="row justify-content" id="Manageholidays_Heaingmaindiv0">
                <div class="col-sm-12 text-end">
                    <button type="button" class="btn btn-label-linkedin waves-effect btn-sm" id="addnewmanagequotes"> Create Quote</button>
                </div>
            </div>
            <div id="ManageQuotemaindiv">
                <div class="col-md-12 col-lg-12 mb-3">
                    <div class="card mb-4">
                        <div class="card-header bg-danger text-white d-flex align-items-center justify-content-between">
                        <span class="text-header">SEARCH QUOTES</span>
                        </div>
                        <div class="card-body">
                            <div class="row col" id="ManageHolidaysMaindivId">
                                <form id="Classificaitionformid">
                                    <div class="row mb-3">
                                        <label class="control-label col-sm-4 col-form-label text-end space">Quote</label>
                                        <div class="col-sm-4">
                                            <input type="text" class="form-control" name="Quote" id="Quote" />
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="control-label col-sm-4 col-form-label text-end space">Display Date</label>
                                        <div class="col-sm-4">
                                            <input type="date" class="form-control" name="Displaydate" id="Displaydate" />
                                        </div>
                                    </div>
                                    <div class="col-sm-12 text-center">
                                        <button type="reset" class="btn btn-danger waves-effect waves-light btn-sm" onclick="Clearcommonfunction('Classificaitionformid', null)" id="Clearbtnquote">Clear</button>
                                        <button type="button" class="btn btn-success waves-effect waves-light btn-sm" id="Searchbtn">Search</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div id="ManageHolidaystbl_containerdivId">
                        <span id="Errmsg" class="text-validation" style="position: fixed; margin: -20px 10px 0px 5px; "></span>
                        <div class="col-md-12 col-lg-12 mb-3">
                            <div class="card mb-4">
                                <div class="card-header bg-danger text-white">
                                    <span class="text-header">
                                        YOUR SEARCH RESULTED
                                        <span id="Quote_Recordscount" class="badge badge-center rounded-pill bg-primary bg-glows text-header">0</span>
                                        RECORDS.
                                    </span>
                                </div>
                                <table class="table table-bordered" id="ManageQuotestbl">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 3%;">SNO</th>
                                            <th style="width: 67%;">Quote</th>
                                            <th>Display Date</th>
                                            <th>Delete</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="Managequotes_Insertdiv2"></div>
            <div id="Managequotes_Updatediv3"></div>
        </div>
    </div>
</body>
</html>

<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js" type="text/javascript"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/Datatable/jquery.dataTables.min.js"></script>
<script src="~/js/Managequote.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
